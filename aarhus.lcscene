{"id": "aarhus", "name": "Aarhus Ø", "version": 1, "engine": 1, "horizon": 0.34, "description": "The harbour skyline seen from a pier on the north shore: Isbjerget, the Lighthouse, cranes, boats and gulls. Windows light up through the evening.", "shader": "// ======================= Aarhus Ø, seen across the bay from the north shore =======================\n// Looking south from the Riis Skov shore: open bay and the Mols/Helgenæs coast to the left (east),\n// the container cranes, Navitas, Isbjerget, Lighthouse and the city to the right (south-west).\n// Everything here is drawn in screen units (height 1); x runs 0..asp().\nconst float K = 1.45;                   // skyline scale (a little larger than life, so it reads on a desktop)\nconst float FH = 0.002 * K;             // one storey on the skyline\nconst float EYE = 1.6;                  // eye height above the pier deck (m)\nconst float WATERY = 2.6;               // eye height above the water (m)\nfloat BASE(){ return HZ - 0.0012; }     // quay line of Aarhus Ø\n\nfloat dark(){ return 1.0 - smoothstep(-0.1, 0.04, uSunDir.y); }\nfloat lightsOn(){ return smoothstep(0.25, 0.6, dark()); }\nfloat occupancy(){                      // share of windows lit, by local hour\n  float h = uHour;\n  return 0.06 + 0.36 * smoothstep(15.5, 18.0, h) * (1.0 - smoothstep(22.0, 24.0, h))\n       + 0.22 * smoothstep(5.5, 7.0, h) * (1.0 - smoothstep(8.0, 9.5, h))\n       + 0.15 * (1.0 - smoothstep(0.0, 1.5, h));\n}\nfloat upr(){ return (1.0 - HZ) / ELT * 180.0 / PI; }     // screen units per radian\nvec2 toScreen(vec3 w){\n  float az = atan(w.x, w.z) * 180.0 / PI;\n  float el = atan(w.y, length(w.xz)) * 180.0 / PI;\n  return vec2((az / AZS + 0.5) * asp(), HZ + el / ELT * (1.0 - HZ));\n}\nfloat aa(float d){ return clamp(d * uRes.y + 0.5, 0.0, 1.0); }   // signed distance (units) -> coverage\n\nvec3 shade(vec3 alb, vec3 N, vec3 amb){\n  vec3 c = alb * amb * 0.72;\n  c += alb * uSunCol * uExpo * max(dot(N, uSunDir), 0.0) * 0.9;\n  c += alb * uMoonLight * uExpo * max(dot(N, uMoonDir), 0.0) * 1.5;\n  return c;\n}\n// lit windows on a facade; f = position from the facade's bottom-left corner\nvec3 windowsAt(vec2 f, float seed, float occ){\n  vec2 g = f / vec2(0.0017 * K, FH);\n  vec2 c = floor(g), r = fract(g);\n  float m = smoothstep(0.12, 0.3, r.x) * smoothstep(0.88, 0.7, r.x) * smoothstep(0.18, 0.35, r.y) * smoothstep(0.9, 0.72, r.y);\n  float busy = 0.55 + 0.9 * hash2(vec2(c.y * 3.1, seed));                  // some floors are busier\n  float h = hash2(c + seed * 17.0);\n  float lit = step(h, occ * busy);\n  vec3 tint = mix(vec3(1.0, 0.68, 0.38), vec3(0.95, 0.9, 0.8), hash2(c * 1.7 + seed));\n  return tint * lit * m * 0.55;\n}\n// a block on the quay. side < 0: its east face shows on the left; side > 0: west face on the right\nvoid block(inout vec3 c, vec2 p, float xc, float w, float storeys, vec3 alb, float seed, float side, float haze, vec3 amb){\n  float x0 = xc - 0.5 * w, x1 = xc + 0.5 * w, top = BASE() + storeys * FH;\n  float px = 1.0 / uRes.y;\n  if(p.x < x0 - px || p.x > x1 + px || p.y > top + px || p.y < BASE()) return;\n  float cov = aa(min(min(p.x - x0, x1 - p.x), top - p.y));\n  float sw = abs(side) * w;\n  float sideFace = side < 0.0 ? step(p.x, x0 + sw) : (side > 0.0 ? step(x1 - sw, p.x) : 0.0);\n  vec3 N = mix(vec3(0.0, 0.0, -1.0), vec3(sign(side), 0.0, 0.0), sideFace);\n  vec2 f = vec2(p.x - x0, p.y - BASE());\n  float fl = fract(f.y / FH);\n  vec3 col = shade(alb * (0.9 + 0.1 * smoothstep(0.0, 0.3, fl)), N, amb);\n  col += windowsAt(f, seed, occupancy()) * dark();\n  col = mix(col, skyAt(vec2(p.x, HZ + 0.004)), haze);\n  c = mix(c, col, cov);\n}\n\n// ---------------- background: far shores and the old city ----------------\nvec3 farShores(vec2 p, vec3 c){\n  float a = asp(), u = p.x / a;\n  vec3 hz = skyAt(vec2(p.x, HZ + 0.006));\n  vec3 land = mix(skyAt(vec2(p.x, 0.9)) * 0.2 + uSunCol * uExpo * 0.04, hz, 0.7);\n  // Mols and Helgenæs, low hills across the bay\n  float mols = HZ + smoothstep(0.26, 0.05, u) * (0.0035 + 0.006 * noise1(p.x * 9.0) + 0.002 * noise1(p.x * 40.0));\n  // Samsø, a faint flat line far out\n  float samso = HZ + 0.0016 * smoothstep(0.27, 0.29, u) * smoothstep(0.37, 0.35, u) * (0.7 + 0.3 * noise1(p.x * 60.0));\n  float top = max(mols, samso);\n  c = mix(c, mix(land, hz, step(0.27, u) * 0.35), aa(top - p.y) * step(HZ - 0.001, p.y));\n  return c;\n}\nvec3 oldCity(vec2 p, vec3 c, vec3 amb){\n  float a = asp(), u = p.x / a;\n  if(u < 0.6 || p.y > HZ + 0.07) return c;\n  float haze = 0.5;\n  vec3 hz = skyAt(vec2(p.x, HZ + 0.006));\n  // low, blocky roofscape behind Aarhus Ø\n  float cell = floor(p.x / (0.007 * K));\n  float roof = BASE() + (0.003 + 0.007 * hash1(cell * 1.3)) * K * smoothstep(0.6, 0.66, u);\n  vec3 body = mix(shade(vec3(0.5, 0.47, 0.44), vec3(0.0, 0.0, -1.0), amb), hz, haze);\n  float cov = aa(roof - p.y);\n  // the cathedral (tower and spire) and the City Hall tower\n  float cx = 0.915 * a, tw = 0.0034 * K;\n  float tower = aa(min(tw - abs(p.x - cx), BASE() + 0.013 * K - p.y));\n  float spire = aa(min((BASE() + 0.027 * K - p.y) * 0.17 - abs(p.x - cx), p.y - BASE() - 0.012 * K));\n  float hx = 0.95 * a;\n  float hall = aa(min(0.0021 * K - abs(p.x - hx), BASE() + 0.016 * K - p.y));\n  cov = max(cov, max(tower, max(spire, hall)));\n  vec3 col = mix(body, body * 0.8, max(spire, tower));\n  // scattered lights in the city at night\n  vec2 g = p / vec2(0.0016, 0.0016);\n  float l = step(0.86, hash2(floor(g) + 3.0)) * smoothstep(0.5, 0.2, length(fract(g) - 0.5)) * step(p.y, roof - 0.001);\n  col += vec3(1.0, 0.72, 0.4) * l * 0.35 * lightsOn() * occupancy() * 1.5;\n  return mix(c, col, cov);\n}\n// ship-to-shore cranes at the container terminal\nvec3 cranes(vec2 p, vec3 c, vec3 amb){\n  float a = asp(), u = p.x / a;\n  if(u < 0.35 || u > 0.5 || p.y > HZ + 0.07) return c;\n  float px = 1.0 / uRes.y, cov = 0.0, light = 0.0;\n  for(int i = 0; i < 3; i++){\n    float fi = float(i);\n    vec2 b = vec2((0.385 + 0.03 * fi) * a, BASE());\n    float H = (0.024 + 0.003 * hash1(fi + 2.0)) * K;\n    float d = 1e3;\n    d = min(d, seg(p, b, b + vec2(0.0, H)));                              // legs\n    d = min(d, seg(p, b + vec2(0.007 * K, 0.0), b + vec2(0.007 * K, H)));\n    d = min(d, seg(p, b + vec2(-0.013 * K, H), b + vec2(0.02 * K, H)));          // boom out over the water\n    d = min(d, seg(p, b + vec2(0.0035 * K, H + 0.008 * K), b + vec2(-0.013 * K, H))); // stays\n    d = min(d, seg(p, b + vec2(0.0035 * K, H + 0.008 * K), b + vec2(0.02 * K, H)));\n    d = min(d, seg(p, b + vec2(0.0, H * 0.45), b + vec2(0.007 * K, H * 0.45)));\n    d = min(d, seg(p, b + vec2(0.0, H), b + vec2(0.0035 * K, H + 0.008 * K)));\n    d = min(d, seg(p, b + vec2(0.007 * K, H), b + vec2(0.0035 * K, H + 0.008 * K)));\n    cov = max(cov, smoothstep(px * 1.1, px * 0.2, d));\n    light += exp(-length(p - b - vec2(0.0035 * K, H + 0.0085 * K)) / (px * 0.9));\n  }\n  vec3 steel = mix(shade(vec3(0.32, 0.36, 0.42), vec3(0.0, 0.0, -1.0), amb), skyAt(vec2(p.x, HZ + 0.01)), 0.5);\n  c = mix(c, steel, cov);\n  return c + vec3(1.0, 0.1, 0.05) * light * lightsOn() * 0.8;\n}\n\n// ---------------- Aarhus Ø itself ----------------\nfloat iceTop(float x, float x0, float x1, float seed){      // one Isbjerget wing: a roof that climbs to a sharp peak\n  float t = (x - x0) / (x1 - x0);\n  float pk = 0.55 + 0.35 * hash1(seed);\n  float lo = (4.0 + 2.0 * hash1(seed + 1.0)) * FH, hi = (9.0 + 3.0 * hash1(seed + 2.0)) * FH, lo2 = (5.0 + 2.0 * hash1(seed + 3.0)) * FH;\n  if(hash1(seed + 4.0) > 0.5){ t = 1.0 - t; }\n  return t < pk ? mix(lo, hi, t / pk) : mix(hi, lo2, (t - pk) / (1.0 - pk));\n}\nvec3 isbjerget(vec2 p, vec3 c, vec3 amb){\n  float a = asp(), x0 = 0.548 * a, ww = 0.0215 * K;\n  if(p.x < x0 || p.x > x0 + 4.0 * ww || p.y > BASE() + 0.045 || p.y < BASE()) return c;\n  float k = floor((p.x - x0) / ww);\n  float wx0 = x0 + k * ww + 0.0012 * K, wx1 = x0 + (k + 1.0) * ww - 0.0012 * K;\n  float top = BASE() + iceTop(p.x, wx0, wx1, k * 7.3 + 1.0);\n  float cov = aa(min(min(p.x - wx0, wx1 - p.x), top - p.y));\n  if(cov <= 0.0) return c;\n  vec2 f = vec2(p.x - wx0, p.y - BASE());\n  // white facades; balconies of blue glass that fade out towards the top\n  vec2 g = f / vec2(0.0024 * K, FH);\n  vec2 cell = floor(g), r = fract(g);\n  float rel = f.y / max(top - BASE(), 1e-3);\n  float balc = step(hash2(cell + k * 5.0), 0.75 - 0.7 * rel) * smoothstep(0.1, 0.25, r.x) * smoothstep(0.9, 0.75, r.x) * step(r.y, 0.45);\n  vec3 alb = mix(vec3(0.86, 0.87, 0.88), vec3(0.22, 0.42, 0.7), balc * 0.85);\n  // the sloped roofs catch the light\n  float roof = smoothstep(0.0035, 0.0, top - p.y);\n  vec3 N = normalize(mix(vec3(0.0, 0.0, -1.0), vec3(0.0, 1.0, -0.4), roof));\n  vec3 col = shade(alb, N, amb);\n  col += windowsAt(f, k + 11.0, occupancy()) * dark() * (1.0 - balc * 0.5);\n  col = mix(col, skyAt(vec2(p.x, HZ + 0.004)), 0.14);\n  return mix(c, col, cov);\n}\nvec3 lighthouse(vec2 p, vec3 c, vec3 amb){\n  float a = asp();\n  float xc = 0.715 * a, w = 0.019 * K, H = 45.0 * FH;\n  if(abs(p.x - xc) > 0.07 * K || p.y > BASE() + H + 0.01 || p.y < BASE()) return c;\n  // Canal House and Promenade House, ten storeys with wavy rooflines\n  float wav1 = BASE() + (9.5 + 0.8 * sin((p.x - xc) * 900.0 / K)) * FH;\n  float x1a = xc - 0.042 * K, x1b = xc - 0.013 * K;\n  float cov1 = aa(min(min(p.x - x1a, x1b - p.x), wav1 - p.y));\n  if(cov1 > 0.0){\n    vec2 f = vec2(p.x - x1a, p.y - BASE());\n    vec3 col = shade(vec3(0.74, 0.74, 0.72) * (0.9 + 0.1 * smoothstep(0.0, 0.3, fract(f.y / FH))), vec3(0.0, 0.0, -1.0), amb);\n    col += windowsAt(f, 31.0, occupancy()) * dark();\n    c = mix(c, mix(col, skyAt(vec2(p.x, HZ + 0.004)), 0.14), cov1);\n  }\n  float x2a = xc + 0.012 * K, x2b = xc + 0.042 * K;\n  float wav2 = BASE() + (9.0 + 0.8 * sin((p.x - xc) * 760.0 / K + 1.0)) * FH;\n  float cov2 = aa(min(min(p.x - x2a, x2b - p.x), wav2 - p.y));\n  if(cov2 > 0.0){\n    vec2 f = vec2(p.x - x2a, p.y - BASE());\n    vec3 col = shade(vec3(0.72, 0.72, 0.7) * (0.9 + 0.1 * smoothstep(0.0, 0.3, fract(f.y / FH))), vec3(0.0, 0.0, -1.0), amb);\n    col += windowsAt(f, 37.0, occupancy()) * dark();\n    c = mix(c, mix(col, skyAt(vec2(p.x, HZ + 0.004)), 0.14), cov2);\n  }\n  // the tower: slender, gently rounded at the top, ringed by white balcony bands\n  float t = (p.x - xc) / (0.5 * w);\n  float dome = 0.006 * K * (1.0 - sqrt(max(1.0 - t * t, 0.0)));\n  float top = BASE() + H - dome;\n  float cov = aa(min(0.5 * w - abs(p.x - xc), top - p.y));\n  if(cov > 0.0){\n    vec2 f = vec2(p.x - (xc - 0.5 * w), p.y - BASE());\n    float band = smoothstep(0.55, 0.75, fract(f.y / FH));\n    vec3 N = normalize(vec3(t * 0.6, 0.0, -1.0));                    // the round corners turn to the sun\n    vec3 col = shade(mix(vec3(0.6, 0.63, 0.66), vec3(0.9, 0.9, 0.88), band), N, amb);\n    col += skyAt(vec2(p.x, HZ + 0.15)) * 0.08 * (1.0 - band);           // glass reflecting the sky\n    col += windowsAt(f, 41.0, occupancy()) * dark() * (1.0 - band);\n    c = mix(c, mix(col, skyAt(vec2(p.x, HZ + 0.004)), 0.12), cov);\n  }\n  // red aircraft-warning light\n  float blink = step(0.5, fract(uT * 0.5));\n  float l = exp(-length(p - vec2(xc, BASE() + H + 0.0006)) * uRes.y / 1.2);\n  return c + vec3(1.0, 0.08, 0.04) * l * blink * lightsOn() * 1.5;\n}\nvec3 harbourFront(vec2 p, vec3 c, vec3 amb){\n  float a = asp();\n  if(p.x < 0.45 * a || p.y > BASE() + 0.14 || p.y < BASE() - 0.002) return c;\n  // Navitas: long, low, glassy\n  block(c, p, 0.5 * a, 0.075 * K, 5.0, vec3(0.42, 0.5, 0.55), 3.0, 0.0, 0.18, amb);\n  c = isbjerget(p, c, amb);\n  c = lighthouse(p, c, amb);\n  // blocks further along the quay\n  block(c, p, 0.778 * a, 0.022 * K, 8.0, vec3(0.66, 0.6, 0.55), 51.0, -0.2, 0.16, amb);\n  block(c, p, 0.8 * a, 0.012 * K, 22.0, vec3(0.62, 0.64, 0.66), 52.0, -0.25, 0.18, amb);\n  block(c, p, 0.827 * a, 0.03 * K, 7.0, vec3(0.7, 0.66, 0.6), 53.0, -0.15, 0.2, amb);\n  block(c, p, 0.86 * a, 0.024 * K, 9.0, vec3(0.55, 0.52, 0.5), 54.0, -0.2, 0.22, amb);\n  block(c, p, 0.887 * a, 0.02 * K, 6.0, vec3(0.68, 0.64, 0.58), 55.0, -0.2, 0.24, amb);\n  // quay wall and a row of lamps along it\n  float px = 1.0 / uRes.y;\n  if(p.x > 0.455 * a && p.x < 0.9 * a){\n    float q = aa(BASE() - p.y) * aa(p.y - (BASE() - 0.0012));\n    c = mix(c, shade(vec3(0.45, 0.44, 0.42), vec3(0.0, 0.0, -1.0), amb) * 0.8, q);\n    float lx = (floor(p.x / (0.009 * K)) + 0.5) * 0.009 * K;\n    float lamp = exp(-length(p - vec2(lx, BASE() + 0.0018)) * uRes.y / 1.1);\n    c += vec3(1.0, 0.75, 0.45) * lamp * lightsOn() * 0.7;\n  }\n  return c;\n}\n\n// ---------------- things moving on the bay and in the sky ----------------\nvec3 ferry(vec2 p, vec3 c, vec3 amb){\n  float a = asp();\n  float t = fract(uClock / 2700.0);                            // a crossing towards Mols every 45 minutes\n  float vis = smoothstep(0.0, 0.03, t) * smoothstep(0.75, 0.7, t);\n  if(vis <= 0.0) return c;\n  float x = mix(0.44, 0.03, t / 0.75) * a, y = HZ - 0.0006;\n  vec2 l = p - vec2(x, y);\n  if(abs(l.x) > 0.07 || abs(l.y) > 0.006) return c;\n  float L = 0.02;\n  float hull = aa(min(min(0.5 * L - abs(l.x) - max(-l.x - 0.3 * L, 0.0) * 0.0, l.y), 0.0009 - l.y));\n  float sup = aa(min(min(0.32 * L - abs(l.x - 0.002), l.y - 0.0008), 0.0026 - l.y - max(-(l.x - 0.002) - 0.18 * L, 0.0) * 0.4));\n  vec3 white = shade(vec3(0.88), vec3(0.0, 0.0, -1.0), amb);\n  vec3 col = mix(c, shade(vec3(0.15, 0.17, 0.2), vec3(0.0, 0.0, -1.0), amb), hull * vis);\n  float win = step(0.0014, l.y) * step(l.y, 0.0019) * step(abs(l.x - 0.001), 0.005);\n  col = mix(col, mix(white, white * 0.35, win), sup * vis);\n  // wake trailing behind (to the right) and lights at night\n  float wake = exp(-abs(l.y + 0.0004) * uRes.y / 1.2) * smoothstep(0.0, 0.01, l.x - 0.5 * L) * exp(-(l.x - 0.5 * L) / 0.03) * step(l.y, 0.0002);\n  col += amb * wake * 0.5 * vis;\n  vec2 g = vec2(l.x / 0.0016, (l.y - 0.0017) / 0.0006);\n  float lights = step(abs(l.x - 0.001), 0.006) * smoothstep(0.5, 0.15, length(vec2(fract(g.x) - 0.5, g.y)));\n  col += vec3(1.0, 0.85, 0.6) * lights * lightsOn() * 0.6 * vis;\n  return col;\n}\nvec3 sailboats(vec2 p, vec3 c, vec3 amb){\n  float a = asp(), day = 1.0 - dark();\n  if(day <= 0.0 || p.y > HZ + 0.012 || p.y < HZ - 0.003) return c;\n  for(int i = 0; i < 2; i++){\n    float fi = float(i);\n    float x = (0.12 + 0.13 * fi + 0.05 * sin(uClock / 1500.0 + fi * 2.3)) * a, y = HZ - 0.0008 - 0.0004 * fi;\n    vec2 l = p - vec2(x, y);\n    float s = 1.0 - 0.25 * fi;\n    float sail = aa(min(min(l.y, 0.0085 * s - l.y), (l.y / (0.0085 * s)) * -0.0028 * s + 0.0028 * s - abs(l.x + 0.0009 * s)));\n    float hull = aa(min(min(0.0028 * s - abs(l.x), l.y + 0.0006 * s), -l.y + 0.0001));\n    c = mix(c, shade(vec3(0.9), normalize(vec3(-0.5, 0.0, -1.0)), amb), sail * day);\n    c = mix(c, shade(vec3(0.2), vec3(0.0, 0.0, -1.0), amb), hull * day);\n  }\n  return c;\n}\nvec3 gulls(vec2 p, vec3 c){\n  float a = asp(), day = 1.0 - dark();\n  if(day <= 0.0 || p.y < HZ + 0.02 || p.y > HZ + 0.25) return c;\n  float px = 1.0 / uRes.y, cov = 0.0;\n  for(int i = 0; i < 3; i++){\n    float fi = float(i);\n    float t = fract(uT / (70.0 + 25.0 * fi) + fi * 0.37);\n    vec2 b = vec2((-0.1 + 1.2 * t) * a, HZ + 0.07 + 0.05 * fi + 0.02 * sin(uT * 0.3 + fi * 2.0));\n    if(fi == 1.0) b.x = a - b.x;                                     // one flies the other way\n    float s = 0.011 - 0.002 * fi;\n    float flap = sin(uT * (6.0 + fi) + fi * 3.0);\n    vec2 tipL = b + vec2(-s, s * (0.25 + 0.35 * flap)), tipR = b + vec2(s, s * (0.25 + 0.35 * flap));\n    vec2 elL = b + vec2(-0.45 * s, s * (0.35 + 0.1 * flap)), elR = b + vec2(0.45 * s, s * (0.35 + 0.1 * flap));\n    float d = min(min(seg(p, b, elL), seg(p, elL, tipL)), min(seg(p, b, elR), seg(p, elR, tipR)));\n    cov = max(cov, smoothstep(px * 1.2, px * 0.2, d));\n  }\n  return mix(c, skyAt(vec2(p.x, 0.9)) * 0.35, cov * day);\n}\n\nvec3 backdrop(vec2 p, vec3 c){\n  if(p.y > HZ + 0.26 || p.y < HZ - 0.012) return c;\n  vec3 amb = skyAmb(p.x);\n  if(p.y < HZ + 0.15){\n    c = farShores(p, c);\n    c = oldCity(p, c, amb);\n    c = cranes(p, c, amb);\n    c = harbourFront(p, c, amb);\n    c = ferry(p, c, amb);\n    c = sailboats(p, c, amb);\n  }\n  return gulls(p, c);\n}\n\n// ---------------- foreground: the pier we stand on, a lamp, a life ring, rocks, a buoy ----------------\nfloat pole(vec2 p, vec3 base, float h, float rad, out float s){\n  vec2 b = toScreen(base), t = toScreen(base + vec3(0.0, h, 0.0));\n  s = (p.y - b.y) / (t.y - b.y);\n  if(s < 0.0 || s > 1.0) return 0.0;\n  float w = rad / length(base.xz) * upr();\n  return aa(w - abs(p.x - b.x));\n}\nconst vec3 LAMP = vec3(-2.3, 0.0, 5.6);   // x, (deck), z of the lamp post\nvec3 lampPos(){ return vec3(LAMP.x, -EYE + 3.75, LAMP.z); }\n\nvec3 pileAt(float i){ return i < 0.5 ? vec3(2.1, -WATERY, 4.2) : (i < 1.5 ? vec3(3.6, -WATERY, 7.5) : (i < 2.5 ? vec3(5.4, -WATERY, 11.5) : vec3(7.8, -WATERY, 17.0))); }\nvec3 piles(vec2 p, vec3 c, vec3 amb, vec3 sunL){\n  // a row of old wooden mooring piles to the right of the pier\n  if(p.x < 0.55 * asp() || p.y > HZ) return c;\n  for(int i = 0; i < 4; i++){\n    float fi = float(i);\n    vec3 b = pileAt(fi);\n    float h = 2.0 + 0.4 * hash1(fi * 3.3);\n    vec2 bs = toScreen(b), t = toScreen(b + vec3(0.0, h, 0.0));\n    float k = upr() / length(b.xz);\n    float wdt = 0.14 * k;\n    float rel = (p.x - bs.x) / wdt;\n    float top = t.y - 0.05 * k * rel * rel;                                    // weathered, rounded top\n    float bob = 0.0015 * sin(uT * 1.2 + fi * 1.7) * (0.5 + uWind);\n    float cov = aa(min(wdt - abs(p.x - bs.x), top - p.y)) * aa(p.y - bs.y - bob);\n    // foam where the swell meets the pile\n    vec2 d = (p - bs) / vec2(0.32 * k, 0.045 * k);\n    float fn = noise2(vec2(p.x / k * 5.0, uT * 0.8 + fi));\n    c += amb * 0.45 * exp(-dot(d, d) * 0.8) * smoothstep(0.35, 0.8, fn) * (0.4 + uWind) * step(p.y, bs.y + 0.002);\n    if(cov <= 0.0) continue;\n    vec3 N = normalize(vec3(rel, 0.0, -sqrt(max(1.0 - rel * rel, 0.0))));\n    float grain = noise2(vec2(rel * 3.0 + fi * 9.0, (p.y - bs.y) / k * 1.2));\n    vec3 alb = mix(vec3(0.24, 0.2, 0.17), vec3(0.4, 0.35, 0.29), grain);\n    alb = mix(alb, vec3(0.09, 0.12, 0.08), smoothstep(0.4 * k, 0.0, p.y - bs.y) * 0.8);   // dark, weedy waterline\n    vec3 col = alb * (amb * 0.7 + sunL * max(dot(N, uSunDir), 0.0) * 0.9 + uMoonLight * uExpo * max(dot(N, uMoonDir), 0.0));\n    c = mix(c, col, cov);\n  }\n  return c;\n}\nvec3 buoy(vec2 p, vec3 c, vec3 amb){\n  vec3 w = vec3(10.0, 0.0, 38.0);\n  float bob = 0.12 * sin(uT * 1.3) * (0.5 + uWind);\n  vec2 b = toScreen(vec3(w.x, -WATERY + bob, w.z));\n  float k = upr() / length(w.xz);\n  vec2 l = p - b;\n  if(abs(l.x) > 0.02 || l.y < -0.003 || l.y > 0.03) return c;\n  float tilt = 0.06 * sin(uT * 1.1);\n  l.x -= l.y * tilt;\n  float body = aa(min(0.4 * k - abs(l.x), min(l.y, 1.6 * k - l.y)));\n  float top = aa(min(0.18 * k - abs(l.x), min(l.y - 1.6 * k, 2.1 * k - l.y)));\n  c = mix(c, shade(vec3(0.75, 0.08, 0.06), vec3(0.0, 0.0, -1.0), amb), body);\n  c = mix(c, shade(vec3(0.2), vec3(0.0, 0.0, -1.0), amb), top);\n  float flash = step(0.82, fract(uT / 4.0)) * lightsOn();\n  c += vec3(1.0, 0.15, 0.08) * exp(-length(l - vec2(0.0, 2.2 * k)) * uRes.y / 1.5) * flash * 1.5;\n  return c;\n}\nvec3 pierDeck(vec2 p, vec3 c, vec3 amb, vec3 sunL){\n  vec3 d = dirOf(azel(p));\n  if(d.y > -0.01) return c;\n  float t = -EYE / d.y;\n  vec3 w = d * t;\n  float mPx = t / (upr() * uRes.y);                    // metres per pixel across the view\n  float mPz = mPx / max(-d.y, 0.02);                   // and along the deck\n  const float RX = 0.9, FZ = 7.0, LX = -4.2;\n  float cov = aa((RX - w.x) / mPx / uRes.y) * aa((w.x - LX) / mPx / uRes.y) * aa((FZ - w.z) / mPz / uRes.y);\n  if(cov <= 0.0) return c;\n  float k = w.z / 0.145, idx = floor(k);\n  float hb = hash1(idx * 3.17);\n  vec3 wood = mix(vec3(0.34, 0.31, 0.27), vec3(0.5, 0.45, 0.38), hb);\n  wood *= 0.82 + 0.3 * noise2(vec2(w.x * 2.2 + hb * 40.0, idx * 1.7)) + 0.08 * noise2(vec2(w.x * 30.0, idx * 5.1));\n  float gd = min(fract(k), 1.0 - fract(k)) * 0.145;\n  float gap = (1.0 - smoothstep(0.004, 0.004 + mPz, gd)) * (1.0 - smoothstep(0.03, 0.1, mPz));\n  wood *= 1.0 - 0.7 * gap;\n  float edge = max(max(smoothstep(RX - 0.2, RX - 0.16, w.x), smoothstep(LX + 0.2, LX + 0.16, w.x)), smoothstep(FZ - 0.2, FZ - 0.16, w.z));\n  wood = mix(wood, vec3(0.27, 0.24, 0.21), edge * 0.7);\n  vec3 col = wood * (amb * mix(0.8, 0.3, dark()) + sunL * max(uSunDir.y, 0.0) * 0.85 + uMoonLight * uExpo * max(uMoonDir.y, 0.0) * 0.8);\n  col += skyAt(vec2(p.x, HZ + (HZ - p.y) * 0.4)) * 0.05 * (1.0 - smoothstep(0.05, 0.4, -d.y));   // damp sheen\n  vec3 L = lampPos() - w;\n  col += vec3(1.0, 0.7, 0.4) * lightsOn() * 3.0 / (1.0 + dot(L, L) * 0.3) * wood;\n  col *= 0.75 + 0.25 * smoothstep(0.0, 0.08, p.y);\n  return mix(c, col, cov);\n}\nvec3 lampGlow(vec2 p){\n  float dl = length(p - toScreen(lampPos()));\n  return vec3(1.0, 0.72, 0.42) * lightsOn() * (0.25 * exp(-dl / 0.012) + 0.06 * exp(-dl / 0.06));\n}\nvec3 lampOnWater(vec2 p, vec3 c){\n  // the lamp's light trembling on the water beyond the pier\n  float lit = lightsOn();\n  if(lit <= 0.0 || p.y > HZ) return c;\n  vec2 lh = toScreen(lampPos());\n  float dz = HZ - p.y;\n  float wob = (noise2(vec2(p.y * 300.0, uT * 1.5)) - 0.5) * 0.006 * (0.5 + uWind);\n  float streak = exp(-abs(p.x - lh.x + wob) / (0.002 + 0.03 * dz)) * smoothstep(0.0, 0.05, dz) * smoothstep(0.32, 0.12, dz);\n  return c + vec3(1.0, 0.7, 0.4) * streak * lit * 0.12 * (0.6 + 0.4 * noise2(vec2(p.x * 200.0, p.y * 900.0 - uT * 2.0)));\n}\n\nvec3 pierThings(vec2 p, vec3 c, vec3 amb, vec3 sunL){\n  vec3 iron = vec3(0.12, 0.13, 0.14);\n  float lit = lightsOn();\n  // bollards at the end of the pier\n  for(int i = 0; i < 2; i++){\n    vec3 b = vec3(i == 0 ? -1.3 : 0.35, -EYE, 6.75);\n    float s; float cov = pole(p, b, 0.55, 0.14, s);\n    if(cov > 0.0){\n      vec3 col = shade(iron * (1.0 + 0.6 * smoothstep(0.8, 1.0, s)), vec3(0.0, 0.3, -1.0), amb);\n      vec3 L = lampPos() - b; col += vec3(1.0, 0.7, 0.4) * lit * 0.4 / (1.0 + dot(L, L) * 0.5);\n      c = mix(c, col, cov);\n    }\n  }\n  // life ring on a post near the right edge\n  vec3 rb = vec3(0.72, -EYE, 3.7);\n  float s; float pc = pole(p, rb, 1.45, 0.05, s);\n  c = mix(c, shade(vec3(0.4, 0.36, 0.3), vec3(0.0, 0.0, -1.0), amb), pc);\n  vec2 rc = toScreen(rb + vec3(0.0, 0.95, -0.06));\n  float k = upr() / length(rb.xz);\n  float rr = length(p - rc);\n  float ring = aa(0.36 * k - rr) * aa(rr - 0.21 * k);\n  if(ring > 0.0){\n    float ang = atan(p.y - rc.y, p.x - rc.x);\n    float seg4 = step(0.5, fract(ang / (PI * 0.5) + 0.125));\n    vec3 alb = mix(vec3(0.85, 0.12, 0.08), vec3(0.9, 0.9, 0.86), seg4);\n    float z = sqrt(max(1.0 - pow((rr / k - 0.285) / 0.075, 2.0), 0.0));\n    vec3 N = normalize(vec3((p - rc) / max(rr, 1e-5) * (1.0 - z), -z - 0.3));\n    vec3 col = shade(alb, N, amb);\n    vec3 L = lampPos() - rb; col += alb * vec3(1.0, 0.7, 0.4) * lit * 0.8 / (1.0 + dot(L, L) * 0.4);\n    c = mix(c, col, ring);\n  }\n  // the lamp post\n  vec3 lb = vec3(LAMP.x, -EYE, LAMP.z);\n  float ls; float lc = pole(p, lb, 3.6, 0.055, ls);\n  c = mix(c, shade(iron, vec3(0.3, 0.0, -1.0), amb), lc);\n  vec2 lh = toScreen(lampPos());\n  float lk = upr() / length(LAMP.xz);\n  vec2 lq = (p - lh) / lk;\n  float head = aa((min(0.17 - abs(lq.x), 0.26 - abs(lq.y)) - 0.0) * lk);\n  float glass = aa((min(0.12 - abs(lq.x), 0.18 - abs(lq.y + 0.02))) * lk);\n  float cap = aa((min(0.22 - abs(lq.x) - max(lq.y - 0.26, 0.0) * 1.5, min(lq.y - 0.24, 0.38 - lq.y))) * lk);\n  c = mix(c, shade(iron, vec3(0.0, 0.3, -1.0), amb), max(head, cap));\n  c = mix(c, mix(shade(vec3(0.5, 0.52, 0.5), vec3(0.0, 0.0, -1.0), amb), vec3(1.6, 1.1, 0.6), lit), glass);\n  return c + lampGlow(p);\n}\nvec3 foreground(vec2 p, vec3 c){\n  if(p.y > HZ + 0.25) return c + lampGlow(p);\n  vec3 amb = skyAmb(p.x), sunL = uSunCol * uExpo;\n  if(p.y < HZ){\n    c = lampOnWater(p, c);\n    c = buoy(p, c, amb);\n    c = piles(p, c, amb, sunL);\n    c = pierDeck(p, c, amb, sunL);\n  }\n  return pierThings(p, c, amb, sunL);\n}\n"}