{"id": "coast", "name": "Living Coast", "version": 2, "engine": 3, "horizon": 0.29, "description": "Dunes and marram grass above a quiet beach, looking south over the sea towards a line of wind turbines.", "shader": "// ======================= Living Coast: dunes and marram grass looking south over the sea =======================\n// The foreground was designed for a horizon at H0; it is drawn in that design space and stretched up to the real horizon.\nconst float H0 = 0.24;\nfloat coast(float x){\n  float a = asp(); float e = smoothstep(0.42*a, 0.33*a, x);\n  return HZ + e * (0.0028 + 0.0045 * fbm3(vec2(x * 9.0, 2.0)));\n}\n// returns coverage of offshore wind turbines + red light glow\nvec2 turbines(vec2 p){\n  float a = asp(), px = 1.0 / uRes.y, cov = 0.0, light = 0.0;\n  if(p.y > HZ + 0.075 || p.x < 0.55*a || p.x > 0.92*a) return vec2(0.0);\n  for(int i = 0; i < 7; i++){\n    float fi = float(i);\n    float x = a * (0.585 + fi * 0.047 + (hash1(fi*3.1) - 0.5) * 0.012);\n    float H = 0.042 * (1.0 - fi * 0.055);\n    vec2 hub = vec2(x, HZ + H);\n    if(abs(p.x - x) > H * 0.75) continue;\n    float w = px * (0.6 + 0.6 * (1.0 - (p.y - HZ) / H));\n    float tower = smoothstep(w + px, w, abs(p.x - x)) * step(p.y, hub.y) * step(HZ - px, p.y);\n    float rot = (uT * 0.5 + 0.6 * uWindT) + fi * 1.7;\n    float bl = 0.0;\n    for(int k = 0; k < 3; k++){\n      float an = rot + float(k) * 2.0944;\n      vec2 tip = hub + vec2(cos(an), sin(an)) * H * 0.62;\n      bl = max(bl, smoothstep(px * 1.3, px * 0.3, seg(p, hub, tip)));\n    }\n    float nac = smoothstep(px*2.2, px*1.2, length((p - hub) * vec2(0.6, 1.4)));\n    cov = max(cov, max(tower, max(bl, nac)));\n    float blink = smoothstep(0.0, 0.1, sin(uT * 2.4)) ;\n    light += exp(-length(p - hub - vec2(0.0, px*1.5)) / (px * 0.8)) * blink;\n  }\n  return vec2(cov, light);\n}\n\nvec3 backdrop(vec2 p, vec3 col){\n  if(p.y < HZ || p.y > HZ + 0.08) return col;\n  vec3 sunL = uSunCol * uExpo;\n  float ch2 = coast(p.x);\n  if(p.y < ch2){\n    vec3 hz = skyAt(vec2(p.x, HZ + 0.006));\n    col = mix(skyAt(vec2(p.x, 0.9)) * 0.18 + sunL * 0.05, hz, 0.72);\n  }\n  vec2 tb = turbines(p);\n  if(tb.x > 0.0){\n    vec3 white = skyAt(vec2(p.x, 0.85)) * 0.5 + sunL * 0.5 * max(0.25 + 0.75 * uSunDir.y, 0.0);\n    vec3 tc = mix(white, skyAt(vec2(p.x, HZ + 0.01)), 0.55);\n    col = mix(col, tc, tb.x);\n  }\n  return col + vec3(1.0, 0.08, 0.04) * tb.y * uNight * 0.9;\n}\nfloat wind(float x){\n  return (0.55 * sin(uT * 1.1 + x * 7.0) + 0.3 * sin(uT * 2.3 + x * 19.0) + 0.6 * (noise1(x * 2.5 - uT * 0.6) - 0.5)) * (0.25 + uWind);\n}\nfloat shoreY(float x){ return 0.064 + 0.008 * (noise1(x * 2.3 + 4.0) - 0.5); }\n// near dune crest (left and right), dropping below the beach in the middle\nfloat dune(float x){\n  float u = x / asp();\n  float L = smoothstep(0.45, 0.25, u) * (0.78 + 0.22 * smoothstep(0.3, 0.0, u));\n  float R = smoothstep(0.66, 0.83, u) * (0.8 + 0.2 * smoothstep(0.8, 1.0, u));\n  float side = smoothstep(0.0, 0.25, L + R);\n  return -0.025 + 0.215 * L + 0.155 * R\n       + side * (0.04 * (noise1(x * 3.2) - 0.5) + 0.012 * (noise1(x * 11.0) - 0.5) + 0.003 * (noise1(x * 47.0) - 0.5));\n}\n// a farther, hazier dune ridge that sits on the beach behind the near one\nfloat duneB(float x){\n  float u = x / asp();\n  float L = pow(smoothstep(0.6, 0.1, u), 1.3), R = pow(smoothstep(0.55, 0.95, u), 1.3);\n  float side = smoothstep(0.0, 0.2, L + R);\n  return 0.05 + 0.11 * L + 0.08 * R + side * (0.02 * (noise1(x * 5.0 + 3.0) - 0.5) + 0.005 * (noise1(x * 23.0) - 0.5));\n}\n// grass-covered band along a dune crest: how far down the face the vegetation reaches\nfloat carpet(float x, float h){\n  return smoothstep(0.03, 0.08, h) * (0.014 + 0.07 * smoothstep(0.25, 0.7, fbm3(vec2(x * 5.0, 3.0))));\n}\n\nvec3 beach(vec2 p, vec2 sp, vec3 sea, vec3 amb, vec3 sunL){\n  float px = 1.0 / uRes.y;\n  float sh = shoreY(p.x), dz = max(H0 - p.y, 0.001);\n  // the swash: each wave runs up the sand and slides back\n  float ph = (uT * 0.42 + 0.25 * uWindT) + noise1(p.x * 1.6) * 4.0;\n  float sw = pow(0.5 + 0.5 * sin(ph), 2.0);\n  float edge = sh + 0.003 - 0.013 * sw + 0.0018 * (noise1(p.x * 38.0 + uT * 0.15) - 0.5);\n  vec2 gp = vec2((p.x - asp() * 0.5) / dz, 1.0 / dz);          // ground-plane coordinates\n  float grain = noise2(gp * vec2(30.0, 3.0)) * 0.6 + noise2(gp * vec2(90.0, 9.0)) * 0.4;\n  vec3 sand = vec3(0.72, 0.62, 0.47) * (0.9 + 0.2 * grain);\n  vec3 dryC = sand * (amb * 0.62 + sunL * max(uSunDir.y, 0.0) * 0.55);\n  vec3 refl = skyAt(vec2(sp.x, HZ + (HZ - sp.y)));\n  vec3 d = dirOf(azel(sp)), R = reflect(d, vec3(0.0, 1.0, 0.0));\n  float glint = pow(max(dot(R, uSunDir), 0.0), 180.0);\n  vec3 wetC = mix(sand * 0.4 * (amb * 0.62 + sunL * max(uSunDir.y, 0.0) * 0.4), refl, 0.5)\n            + uSunDisk * uExpo * glint * 0.015 + uMoonCol * uExpo * pow(max(dot(R, uMoonDir), 0.0), 150.0) * 0.15;\n  float wet = smoothstep(sh - 0.02, sh - 0.004, p.y);\n  vec3 c = mix(dryC, wetC, wet);\n  // thin water film, then open sea, with a broken line of foam at the edge\n  float w = smoothstep(edge - px, edge + px, p.y);\n  c = mix(c, mix(wetC, sea, 0.6 + 0.4 * smoothstep(edge, edge + 0.012, p.y)), w);\n  float fn = noise2(vec2(p.x * 160.0, uT * 0.5 + p.x * 3.0)) * 0.7 + noise2(vec2(p.x * 40.0, uT * 0.3)) * 0.3;\n  float foam = exp(-abs(p.y - edge - 0.0012) / 0.0011) * smoothstep(0.32, 0.7, fn + 0.25 * sw);\n  foam += exp(-abs(p.y - edge - 0.0045) / 0.0025) * 0.25 * smoothstep(0.45, 0.8, fn) * w;\n  c += (amb * 0.85 + sunL * 0.45 * max(uSunDir.y + 0.08, 0.0) + uMoonLight * uExpo * 0.5) * foam;\n  return c;\n}\n\nvec3 sandShade(vec2 p, float h, float slope, vec3 amb, vec3 sunL){\n  float down = h - p.y;\n  float depth = clamp(down / 0.09, 0.0, 1.0);                     // 0 at the crest, 1 down the face toward us\n  float rip = noise2(vec2(p.x * 26.0 + down * 30.0, down * mix(320.0, 110.0, depth) + noise1(p.x * 11.0) * 3.0));\n  float grain = hash2(floor(gl_FragCoord.xy)) - 0.5;\n  vec3 N = normalize(vec3(-slope * 2.2 + (rip - 0.5) * 0.3, 1.0 - 0.2 * depth, -0.2 - 0.9 * depth));\n  float dif = max(dot(N, uSunDir) * 0.55 + 0.45, 0.0) * smoothstep(-0.02, 0.03, uSunDir.y);\n  vec3 sand = vec3(0.76, 0.66, 0.5) * (0.93 + 0.14 * rip + 0.05 * grain);\n  vec3 c = sand * (amb * (0.55 + 0.45 * N.y) * 0.8 + sunL * dif * 0.8);\n  float back = max(uSunDir.z, 0.0) * (1.0 - smoothstep(0.05, 0.5, uSunDir.y));\n  c += sunL * vec3(1.0, 0.8, 0.55) * exp(-down / 0.003) * back * 0.4;   // rim of light along the crest\n  c += uMoonLight * uExpo * sand * (0.3 + 0.7 * max(dot(N, uMoonDir), 0.0)) * 0.8;\n  return c;\n}\n\nvec3 grassCol(float s, float hb, float seed, float x, vec3 amb, vec3 sunL){\n  vec3 green = vec3(0.25, 0.31, 0.19), straw = vec3(0.68, 0.6, 0.4);\n  vec3 base = mix(green, straw, clamp(s * 0.8 + (hb - 0.5) * 0.7, 0.0, 1.0));\n  base = mix(base, vec3(0.62, 0.5, 0.34), seed);\n  vec3 c = base * amb * (0.42 + 0.38 * s);\n  c += base * sunL * max(uSunDir.y + 0.04, 0.0) * (0.35 + 0.45 * s);\n  // translucent blades glow when the low sun is in front of us\n  float back = max(uSunDir.z, 0.0) * (1.0 - smoothstep(0.08, 0.55, uSunDir.y)) * smoothstep(-0.03, 0.01, uSunDir.y);\n  float near = 0.4 + 0.6 * exp(-abs(x - uSunP.x) * 2.2);\n  c += sunL * vec3(1.0, 0.76, 0.4) * back * near * pow(s, 1.4) * (0.5 + 0.5 * hb) * (0.8 + 0.6 * seed);\n  c += uMoonLight * uExpo * 0.8 * pow(s, 1.5);\n  return c;\n}\n\n// short dense grass covering the dune crest, thinning out down the face: (coverage, tone, local density)\nfloat turfDensity(vec2 q, float hf, float cd){\n  float kk = max(hf - q.y, 0.0) / cd;\n  return smoothstep(0.25, 0.6, noise2(q * vec2(48.0, 19.0)) * 0.75 + noise2(q * vec2(150.0, 60.0)) * 0.25 + 0.55 - 0.95 * pow(kk, 1.2));\n}\nvec3 turf(vec2 p, float cd){\n  float px = 1.0 / uRes.y;\n  const vec2 CS = vec2(0.0034, 0.0065);\n  vec2 c0 = floor(p / CS);\n  float best = 0.0, tone = 0.0;\n  for(int i = -2; i <= 2; i++){\n    for(int j = -3; j <= 0; j++){\n      vec2 c = c0 + vec2(float(i), float(j));\n      float h = hash2(c);\n      vec2 root = (c + vec2(hash2(c + 3.1), hash2(c + 7.7))) * CS;\n      float hf = dune(root.x);\n      if(root.y > hf - 0.001) continue;\n      if(h > turfDensity(root, hf, cd) * 0.95) continue;\n      float H = 0.007 + 0.015 * hash2(c + 1.7);\n      float s = (p.y - root.y) / H;\n      if(s < 0.0 || s > 1.0) continue;\n      float lean = clamp((hash2(c + 5.3) - 0.5) * 0.5 + wind(root.x) * 0.1, -0.25, 0.25) * H;\n      float w = 0.0011 * (1.0 - 0.85 * s) + 0.35 * px;\n      float cov = smoothstep(w + px, w, abs(p.x - root.x - lean * s * s));\n      if(cov > best){ best = cov; tone = s * 0.6 + h * 0.4; }\n    }\n  }\n  return vec3(best, tone, 0.0);\n}\n\n// marram tussocks on the near dune: (coverage, height along blade, blade hash, seed head)\nvec4 tussocks(vec2 p, out float ao){\n  float px = 1.0 / uRes.y;\n  const float CW = 0.026;\n  float c0 = floor(p.x / CW);\n  vec4 res = vec4(0.0); ao = 0.0;\n  for(int k = -5; k <= 5; k++){\n    float c = c0 + float(k);\n    float xr = (c + 0.15 + 0.7 * hash1(c * 4.13 + 2.0)) * CW;\n    float gy = dune(xr);\n    float dens = smoothstep(0.028, 0.075, gy);\n    if(dens <= 0.0 || hash1(c * 1.73 + 0.31) > 0.15 + 0.85 * dens) continue;\n    float low = hash1(c * 9.71) * 0.035 * dens;                   // some sit lower on the face, nearer to us\n    float root = gy - 0.003 - low;\n    float sc = (0.7 + 0.45 * hash1(c * 2.93)) * (0.75 + 0.25 * dens) * (1.0 + low * 6.0);\n    float Hm = 0.1 * sc;\n    if(p.y < root - 0.01 || p.y > root + Hm || abs(p.x - xr) > Hm * 0.86 + 0.01) continue;\n    vec2 q = (p - vec2(xr, root)) / (sc * vec2(0.032, 0.011));\n    ao = max(ao, exp(-dot(q, q)));\n    float gust = wind(xr) * 0.3;\n    for(int j = 0; j < 15; j++){\n      float fj = float(j);\n      float h1 = hash1(c * 17.13 + fj * 3.17), h2 = hash1(c * 5.37 + fj * 7.91), h3 = hash1(c * 1.1 + fj * 13.7);\n      float th = (h1 - 0.5) * 1.25;                                // fan angle\n      float H = Hm * (0.5 + 0.5 * h2) * (1.0 - 0.3 * abs(th));\n      float vy = H * cos(th * 0.7);\n      float s = (p.y - root) / vy;\n      if(s < 0.0 || s > 1.0) continue;\n      float vx = H * sin(th * 0.7);\n      float flutter = sin(uT * (2.0 + 3.0 * h3) + fj * 1.7) * 0.05 * (0.3 + uWind);\n      float bend = (th * 0.4 + gust * (0.6 + 0.8 * h1) + flutter) * H;   // blades curl over with height and wind\n      bend = clamp(bend, -0.85 * H - vx, 0.85 * H - vx);\n      float bx = xr + (h3 - 0.5) * 0.014 * sc + vx * s + bend * s * s;\n      float dx = (vx + 2.0 * bend * s) / vy, st = sqrt(1.0 + dx * dx);\n      float w = (0.0021 * sc * (1.0 - 0.92 * s) + 0.35 * px) * st;\n      float seed = 0.0;\n      if(h2 > 0.72 && s > 0.74){ seed = 1.0; w = max(w, 0.0023 * sc * sin(PI * (s - 0.74) / 0.26) * st); }\n      float cov = smoothstep(w + px, w, abs(p.x - bx));\n      if(cov > res.x) res = vec4(cov, s, h1 + 2.0 * seed, clamp((p.x - bx) / max(w, px), -1.0, 1.0));\n    }\n  }\n  return res;\n}\n// loose single blades between tussocks: (coverage, height along blade)\nvec2 blades(vec2 p){\n  float px = 1.0 / uRes.y, cw = 0.008, best = 0.0, hb = 0.0;\n  float c0 = floor(p.x / cw);\n  for(int k = -4; k <= 4; k++){\n    float c = c0 + float(k);\n    float xr = (c + hash1(c * 3.7)) * cw;\n    float gy = dune(xr);\n    float dens = smoothstep(0.03, 0.08, gy);\n    if(hash1(c * 7.3) > dens * 0.9) continue;\n    float root = gy - 0.004 - 0.022 * hash1(c * 5.1) * dens;\n    float H = 0.018 + 0.04 * hash1(c * 2.2);\n    float s = (p.y - root) / H;\n    if(s < 0.0 || s > 1.0) continue;\n    float lean = clamp((hash1(c * 1.9) - 0.5) * 0.6 + wind(xr) * 0.3, -0.5, 0.5) * H;\n    float bx = xr + lean * s * s;\n    float w = 0.0013 * (1.0 - 0.9 * s) + 0.35 * px;\n    float cov = smoothstep(w + px, w, abs(p.x - bx));\n    if(cov > best){ best = cov; hb = s; }\n  }\n  return vec2(best, hb);\n}\n// fine grass fringe along the far dune crest\nfloat backBlades(vec2 p){\n  float px = 1.0 / uRes.y, cw = 0.0035, best = 0.0;\n  float c0 = floor(p.x / cw);\n  for(int k = -4; k <= 4; k++){\n    float c = c0 + float(k);\n    float xr = (c + hash1(c * 3.1 + 1.0)) * cw;\n    float gy = duneB(xr);\n    if(hash1(c * 6.7 + 2.0) > smoothstep(0.075, 0.11, gy) * 0.9) continue;\n    float H = 0.007 + 0.019 * hash1(c * 8.3);\n    float s = (p.y - gy + 0.002) / H;\n    if(s < 0.0 || s > 1.0) continue;\n    float lean = clamp((hash1(c * 2.3) - 0.5) * 0.6 + wind(xr) * 0.25, -0.4, 0.4) * H;\n    float w = 0.0011 * (1.0 - 0.9 * s) + 0.3 * px;\n    best = max(best, smoothstep(w + px, w, abs(p.x - xr - lean * s * s)));\n  }\n  return best;\n}\n\nvec3 foreground(vec2 sp, vec3 col){\n  vec2 p = vec2(sp.x, sp.y * H0 / HZ);\n  float a = asp(), px = 1.0 / uRes.y;\n  vec3 sunL = uSunCol * uExpo;\n  if(p.y >= 0.42) return col;\n    vec3 amb = skyAmb(p.x);\n    vec3 haze = skyAt(vec2(p.x, HZ + 0.012));\n    if(p.y < shoreY(p.x) + 0.006) col = beach(p, sp, col, amb, sunL);\n    // far dune\n    float hb = duneB(p.x);\n    if(p.y < hb + 0.03 && p.y > 0.035){\n      float sB = (duneB(p.x + 0.015) - duneB(p.x - 0.015)) / 0.03;\n      vec3 sc = sandShade(p, hb, sB, amb, sunL) * 0.9;\n      float cdB = carpet(p.x + 7.0, hb - 0.03) * 0.6, dB = hb - p.y;\n      if(cdB > 0.0){\n        float lim = cdB * (0.7 + 0.6 * noise1(p.x * 200.0));\n        float st = noise2(vec2(p.x * 160.0, p.y * 70.0));\n        sc = mix(sc, grassCol(0.35 + 0.2 * st, 0.5, 0.0, p.x, amb, sunL) * (0.7 + 0.2 * st), smoothstep(lim, lim - 0.003, dB));\n      }\n      sc = mix(sc, haze, 0.28);\n      col = mix(col, sc, smoothstep(hb + px, hb - px, p.y) * smoothstep(0.035, 0.05, p.y) * smoothstep(0.06, 0.075, hb));\n      float bb = backBlades(p);\n      if(bb > 0.0) col = mix(col, mix(grassCol(0.7, 0.5, 0.0, p.x, amb, sunL) * 0.75, haze, 0.25), bb);\n    }\n    // near dune\n    float hf = dune(p.x);\n    if(p.y < hf + 0.14){\n      float ao; vec4 tu = tussocks(p, ao);\n      float cd = carpet(p.x, hf);\n      if(p.y < hf + px){\n        float sF = (dune(p.x + 0.015) - dune(p.x - 0.015)) / 0.03;\n        vec3 sc = sandShade(p, hf, sF, amb, sunL) * (1.0 - 0.55 * ao);\n        if(cd > 0.0 && hf - p.y < cd * 1.6)                       // shadowed grass between the blades\n          sc = mix(sc, grassCol(0.2, 0.3, 0.0, p.x, amb, sunL) * 0.55, smoothstep(0.3, 1.0, turfDensity(p + vec2(0.0, 0.005), hf, cd)) * 0.75);\n        col = mix(col, sc, smoothstep(hf + px, hf - px, p.y) * smoothstep(-0.015, 0.035, hf));   // toe melts into the beach\n      }\n      if(cd > 0.0 && hf - p.y < cd * 1.6 && p.y < hf + 0.023){\n        vec3 tf = turf(p, cd);\n        if(tf.x > 0.0) col = mix(col, grassCol(0.2 + 0.6 * tf.y, tf.y, 0.0, p.x, amb, sunL) * (0.65 + 0.4 * tf.y), tf.x);\n      }\n      vec2 bl = blades(p);\n      if(bl.x > 0.0) col = mix(col, grassCol(bl.y, 0.4, 0.0, p.x, amb, sunL) * 0.92, bl.x);\n      if(tu.x > 0.0){\n        float seed = step(2.0, tu.z), h = tu.z - 2.0 * seed;\n        float side = 1.0 + 0.22 * tu.w * sign(uSunDir.x + 1e-3) * (1.0 - smoothstep(0.3, 0.8, uSunDir.y));\n        col = mix(col, grassCol(tu.y, h, seed, p.x, amb, sunL) * (0.72 + 0.45 * fract(h * 7.3)) * side, tu.x);\n      }\n    }\n    col *= 0.72 + 0.28 * smoothstep(0.0, 0.07, p.y);                   // settle the bottom edge\n  return col;\n}\n\n// ======================= the whole picture (engine 3) =======================\n// The scene decides what is drawn: here the engine's standard sky and sea, then the wind turbines and the dunes, and the\n// standard weather in front of it all. Any of these could be swapped for the scene's own version.\nvec3 seaReflection(vec2 p, vec3 c){ return backdrop(p, c); }   // the sea mirrors the wind turbines\nvec3 scene(vec2 s){\n  vec2 p = lens(s);\n  vec3 col = p.y >= HZ ? sky(p) : sea(p);\n  if(p.y > HZ - 0.015) col = backdrop(p, col);\n  col = foreground(p, col);\n  return weather(p, col);\n}\n"}