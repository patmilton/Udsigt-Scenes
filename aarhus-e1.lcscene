{"id": "aarhus", "name": "Aarhus Ø", "version": 2, "engine": 1, "horizon": 0.34, "description": "The harbour skyline seen from a pier on the north shore. Boats, kayaks, swimmers, ducks and gulls come and go; windows light up through the evening.", "shader": "// ======================= Aarhus Ø, seen across the bay from the north shore =======================\n// Looking south from the Riis Skov shore: open bay and the Mols/Helgenæs coast to the left (east),\n// the container cranes, Navitas, Isbjerget, Lighthouse and the city to the right (south-west).\n// Everything here is drawn in screen units (height 1); x runs 0..asp().\nconst float K = 1.45;                   // skyline scale (a little larger than life, so it reads on a desktop)\nconst float FH = 0.002 * K;             // one storey on the skyline\nconst float EYE = 1.6;                  // eye height above the pier deck (m)\nconst float WATERY = 2.6;               // eye height above the water (m)\nfloat BASE(){ return HZ - 0.0012; }     // quay line of Aarhus Ø\n\nfloat dark(){ return 1.0 - smoothstep(-0.1, 0.04, uSunDir.y); }\nfloat lightsOn(){ return smoothstep(0.25, 0.6, dark()); }\nfloat occupancy(){                      // share of windows lit, by local hour\n  float h = uHour;\n  return 0.06 + 0.36 * smoothstep(15.5, 18.0, h) * (1.0 - smoothstep(22.0, 24.0, h))\n       + 0.22 * smoothstep(5.5, 7.0, h) * (1.0 - smoothstep(8.0, 9.5, h))\n       + 0.15 * (1.0 - smoothstep(0.0, 1.5, h));\n}\nfloat upr(){ return (1.0 - HZ) / ELT * 180.0 / PI; }     // screen units per radian\nvec2 toScreen(vec3 w){\n  float az = atan(w.x, w.z) * 180.0 / PI;\n  float el = atan(w.y, length(w.xz)) * 180.0 / PI;\n  return vec2((az / AZS + 0.5) * asp(), HZ + el / ELT * (1.0 - HZ));\n}\nfloat aa(float d){ return clamp(d * uRes.y + 0.5, 0.0, 1.0); }   // signed distance (units) -> coverage\n\nvec3 shade(vec3 alb, vec3 N, vec3 amb){\n  vec3 c = alb * amb * 0.72;\n  c += alb * uSunCol * uExpo * max(dot(N, uSunDir), 0.0) * 0.9;\n  c += alb * uMoonLight * uExpo * max(dot(N, uMoonDir), 0.0) * 1.5;\n  return c;\n}\n// lit windows on a facade; f = position from the facade's bottom-left corner\nvec3 windowsAt(vec2 f, float seed, float occ){\n  vec2 g = f / vec2(0.0017 * K, FH);\n  vec2 c = floor(g), r = fract(g);\n  float m = smoothstep(0.12, 0.3, r.x) * smoothstep(0.88, 0.7, r.x) * smoothstep(0.18, 0.35, r.y) * smoothstep(0.9, 0.72, r.y);\n  float busy = 0.55 + 0.9 * hash2(vec2(c.y * 3.1, seed));                  // some floors are busier\n  float h = hash2(c + seed * 17.0);\n  float lit = step(h, occ * busy);\n  vec3 tint = mix(vec3(1.0, 0.68, 0.38), vec3(0.95, 0.9, 0.8), hash2(c * 1.7 + seed));\n  return tint * lit * m * 0.55;\n}\n// a block on the quay. side < 0: its east face shows on the left; side > 0: west face on the right\nvoid block(inout vec3 c, vec2 p, float xc, float w, float storeys, vec3 alb, float seed, float side, float haze, vec3 amb){\n  float x0 = xc - 0.5 * w, x1 = xc + 0.5 * w, top = BASE() + storeys * FH;\n  float px = 1.0 / uRes.y;\n  if(p.x < x0 - px || p.x > x1 + px || p.y > top + px || p.y < BASE()) return;\n  float cov = aa(min(min(p.x - x0, x1 - p.x), top - p.y));\n  float sw = abs(side) * w;\n  float sideFace = side < 0.0 ? step(p.x, x0 + sw) : (side > 0.0 ? step(x1 - sw, p.x) : 0.0);\n  vec3 N = mix(vec3(0.0, 0.0, -1.0), vec3(sign(side), 0.0, 0.0), sideFace);\n  vec2 f = vec2(p.x - x0, p.y - BASE());\n  float fl = fract(f.y / FH);\n  vec3 col = shade(alb * (0.9 + 0.1 * smoothstep(0.0, 0.3, fl)), N, amb);\n  col += windowsAt(f, seed, occupancy()) * dark();\n  col = mix(col, skyAt(vec2(p.x, HZ + 0.004)), haze);\n  c = mix(c, col, cov);\n}\n\n// ---------------- background: far shores and the old city ----------------\nvec3 farShores(vec2 p, vec3 c){\n  float a = asp(), u = p.x / a;\n  vec3 hz = skyAt(vec2(p.x, HZ + 0.006));\n  vec3 land = mix(skyAt(vec2(p.x, 0.9)) * 0.2 + uSunCol * uExpo * 0.04, hz, 0.7);\n  // Mols and Helgenæs, low hills across the bay\n  float mols = HZ + smoothstep(0.26, 0.05, u) * (0.0035 + 0.006 * noise1(p.x * 9.0) + 0.002 * noise1(p.x * 40.0));\n  // Samsø, a faint flat line far out\n  float samso = HZ + 0.0016 * smoothstep(0.27, 0.29, u) * smoothstep(0.37, 0.35, u) * (0.7 + 0.3 * noise1(p.x * 60.0));\n  float top = max(mols, samso);\n  c = mix(c, mix(land, hz, step(0.27, u) * 0.35), aa(top - p.y) * step(HZ - 0.001, p.y));\n  return c;\n}\nvec3 oldCity(vec2 p, vec3 c, vec3 amb){\n  float a = asp(), u = p.x / a;\n  if(u < 0.6 || p.y > HZ + 0.07) return c;\n  float haze = 0.5;\n  vec3 hz = skyAt(vec2(p.x, HZ + 0.006));\n  // low, blocky roofscape behind Aarhus Ø\n  float cell = floor(p.x / (0.007 * K));\n  float roof = BASE() + (0.003 + 0.007 * hash1(cell * 1.3)) * K * smoothstep(0.6, 0.66, u);\n  vec3 body = mix(shade(vec3(0.5, 0.47, 0.44), vec3(0.0, 0.0, -1.0), amb), hz, haze);\n  float cov = aa(roof - p.y);\n  // the cathedral (tower and spire) and the City Hall tower\n  float cx = 0.915 * a, tw = 0.0034 * K;\n  float tower = aa(min(tw - abs(p.x - cx), BASE() + 0.013 * K - p.y));\n  float spire = aa(min((BASE() + 0.027 * K - p.y) * 0.17 - abs(p.x - cx), p.y - BASE() - 0.012 * K));\n  float hx = 0.95 * a;\n  float hall = aa(min(0.0021 * K - abs(p.x - hx), BASE() + 0.016 * K - p.y));\n  cov = max(cov, max(tower, max(spire, hall)));\n  vec3 col = mix(body, body * 0.8, max(spire, tower));\n  // scattered lights in the city at night\n  vec2 g = p / vec2(0.0016, 0.0016);\n  float l = step(0.86, hash2(floor(g) + 3.0)) * smoothstep(0.5, 0.2, length(fract(g) - 0.5)) * step(p.y, roof - 0.001);\n  col += vec3(1.0, 0.72, 0.4) * l * 0.35 * lightsOn() * occupancy() * 1.5;\n  return mix(c, col, cov);\n}\n// ship-to-shore cranes at the container terminal\nvec3 cranes(vec2 p, vec3 c, vec3 amb){\n  float a = asp(), u = p.x / a;\n  if(u < 0.35 || u > 0.5 || p.y > HZ + 0.07) return c;\n  float px = 1.0 / uRes.y, cov = 0.0, light = 0.0;\n  for(int i = 0; i < 3; i++){\n    float fi = float(i);\n    vec2 b = vec2((0.385 + 0.03 * fi) * a, BASE());\n    float H = (0.024 + 0.003 * hash1(fi + 2.0)) * K;\n    float d = 1e3;\n    d = min(d, seg(p, b, b + vec2(0.0, H)));                              // legs\n    d = min(d, seg(p, b + vec2(0.007 * K, 0.0), b + vec2(0.007 * K, H)));\n    d = min(d, seg(p, b + vec2(-0.013 * K, H), b + vec2(0.02 * K, H)));          // boom out over the water\n    d = min(d, seg(p, b + vec2(0.0035 * K, H + 0.008 * K), b + vec2(-0.013 * K, H))); // stays\n    d = min(d, seg(p, b + vec2(0.0035 * K, H + 0.008 * K), b + vec2(0.02 * K, H)));\n    d = min(d, seg(p, b + vec2(0.0, H * 0.45), b + vec2(0.007 * K, H * 0.45)));\n    d = min(d, seg(p, b + vec2(0.0, H), b + vec2(0.0035 * K, H + 0.008 * K)));\n    d = min(d, seg(p, b + vec2(0.007 * K, H), b + vec2(0.0035 * K, H + 0.008 * K)));\n    cov = max(cov, smoothstep(px * 1.1, px * 0.2, d));\n    light += exp(-length(p - b - vec2(0.0035 * K, H + 0.0085 * K)) / (px * 0.9));\n  }\n  vec3 steel = mix(shade(vec3(0.32, 0.36, 0.42), vec3(0.0, 0.0, -1.0), amb), skyAt(vec2(p.x, HZ + 0.01)), 0.5);\n  c = mix(c, steel, cov);\n  return c + vec3(1.0, 0.1, 0.05) * light * lightsOn() * 0.8;\n}\n\n// ---------------- Aarhus Ø itself ----------------\nfloat iceTop(float x, float x0, float x1, float seed){      // one Isbjerget wing: a roof that climbs to a sharp peak\n  float t = (x - x0) / (x1 - x0);\n  float pk = 0.55 + 0.35 * hash1(seed);\n  float lo = (4.0 + 2.0 * hash1(seed + 1.0)) * FH, hi = (9.0 + 3.0 * hash1(seed + 2.0)) * FH, lo2 = (5.0 + 2.0 * hash1(seed + 3.0)) * FH;\n  if(hash1(seed + 4.0) > 0.5){ t = 1.0 - t; }\n  return t < pk ? mix(lo, hi, t / pk) : mix(hi, lo2, (t - pk) / (1.0 - pk));\n}\nvec3 isbjerget(vec2 p, vec3 c, vec3 amb){\n  float a = asp(), x0 = 0.548 * a, ww = 0.0215 * K;\n  if(p.x < x0 || p.x > x0 + 4.0 * ww || p.y > BASE() + 0.045 || p.y < BASE()) return c;\n  float k = floor((p.x - x0) / ww);\n  float wx0 = x0 + k * ww + 0.0012 * K, wx1 = x0 + (k + 1.0) * ww - 0.0012 * K;\n  float top = BASE() + iceTop(p.x, wx0, wx1, k * 7.3 + 1.0);\n  float cov = aa(min(min(p.x - wx0, wx1 - p.x), top - p.y));\n  if(cov <= 0.0) return c;\n  vec2 f = vec2(p.x - wx0, p.y - BASE());\n  // white facades; balconies of blue glass that fade out towards the top\n  vec2 g = f / vec2(0.0024 * K, FH);\n  vec2 cell = floor(g), r = fract(g);\n  float rel = f.y / max(top - BASE(), 1e-3);\n  float balc = step(hash2(cell + k * 5.0), 0.75 - 0.7 * rel) * smoothstep(0.1, 0.25, r.x) * smoothstep(0.9, 0.75, r.x) * step(r.y, 0.45);\n  vec3 alb = mix(vec3(0.86, 0.87, 0.88), vec3(0.22, 0.42, 0.7), balc * 0.85);\n  // the sloped roofs catch the light\n  float roof = smoothstep(0.0035, 0.0, top - p.y);\n  vec3 N = normalize(mix(vec3(0.0, 0.0, -1.0), vec3(0.0, 1.0, -0.4), roof));\n  vec3 col = shade(alb, N, amb);\n  col += windowsAt(f, k + 11.0, occupancy()) * dark() * (1.0 - balc * 0.5);\n  col = mix(col, skyAt(vec2(p.x, HZ + 0.004)), 0.14);\n  return mix(c, col, cov);\n}\nvec3 lighthouse(vec2 p, vec3 c, vec3 amb){\n  float a = asp();\n  float xc = 0.715 * a, w = 0.019 * K, H = 45.0 * FH;\n  if(abs(p.x - xc) > 0.07 * K || p.y > BASE() + H + 0.01 || p.y < BASE()) return c;\n  // Canal House and Promenade House, ten storeys with wavy rooflines\n  float wav1 = BASE() + (9.5 + 0.8 * sin((p.x - xc) * 900.0 / K)) * FH;\n  float x1a = xc - 0.042 * K, x1b = xc - 0.013 * K;\n  float cov1 = aa(min(min(p.x - x1a, x1b - p.x), wav1 - p.y));\n  if(cov1 > 0.0){\n    vec2 f = vec2(p.x - x1a, p.y - BASE());\n    vec3 col = shade(vec3(0.74, 0.74, 0.72) * (0.9 + 0.1 * smoothstep(0.0, 0.3, fract(f.y / FH))), vec3(0.0, 0.0, -1.0), amb);\n    col += windowsAt(f, 31.0, occupancy()) * dark();\n    c = mix(c, mix(col, skyAt(vec2(p.x, HZ + 0.004)), 0.14), cov1);\n  }\n  float x2a = xc + 0.012 * K, x2b = xc + 0.042 * K;\n  float wav2 = BASE() + (9.0 + 0.8 * sin((p.x - xc) * 760.0 / K + 1.0)) * FH;\n  float cov2 = aa(min(min(p.x - x2a, x2b - p.x), wav2 - p.y));\n  if(cov2 > 0.0){\n    vec2 f = vec2(p.x - x2a, p.y - BASE());\n    vec3 col = shade(vec3(0.72, 0.72, 0.7) * (0.9 + 0.1 * smoothstep(0.0, 0.3, fract(f.y / FH))), vec3(0.0, 0.0, -1.0), amb);\n    col += windowsAt(f, 37.0, occupancy()) * dark();\n    c = mix(c, mix(col, skyAt(vec2(p.x, HZ + 0.004)), 0.14), cov2);\n  }\n  // the tower: slender, gently rounded at the top, ringed by white balcony bands\n  float t = (p.x - xc) / (0.5 * w);\n  float dome = 0.006 * K * (1.0 - sqrt(max(1.0 - t * t, 0.0)));\n  float top = BASE() + H - dome;\n  float cov = aa(min(0.5 * w - abs(p.x - xc), top - p.y));\n  if(cov > 0.0){\n    vec2 f = vec2(p.x - (xc - 0.5 * w), p.y - BASE());\n    float band = smoothstep(0.55, 0.75, fract(f.y / FH));\n    vec3 N = normalize(vec3(t * 0.6, 0.0, -1.0));                    // the round corners turn to the sun\n    vec3 col = shade(mix(vec3(0.6, 0.63, 0.66), vec3(0.9, 0.9, 0.88), band), N, amb);\n    col += skyAt(vec2(p.x, HZ + 0.15)) * 0.08 * (1.0 - band);           // glass reflecting the sky\n    col += windowsAt(f, 41.0, occupancy()) * dark() * (1.0 - band);\n    c = mix(c, mix(col, skyAt(vec2(p.x, HZ + 0.004)), 0.12), cov);\n  }\n  // red aircraft-warning light\n  float blink = step(0.5, fract(uT * 0.5));\n  float l = exp(-length(p - vec2(xc, BASE() + H + 0.0006)) * uRes.y / 1.2);\n  return c + vec3(1.0, 0.08, 0.04) * l * blink * lightsOn() * 1.5;\n}\nvec3 harbourFront(vec2 p, vec3 c, vec3 amb){\n  float a = asp();\n  if(p.x < 0.45 * a || p.y > BASE() + 0.14 || p.y < BASE() - 0.002) return c;\n  // Navitas: long, low, glassy\n  block(c, p, 0.5 * a, 0.075 * K, 5.0, vec3(0.42, 0.5, 0.55), 3.0, 0.0, 0.18, amb);\n  c = isbjerget(p, c, amb);\n  c = lighthouse(p, c, amb);\n  // blocks further along the quay\n  block(c, p, 0.778 * a, 0.022 * K, 8.0, vec3(0.66, 0.6, 0.55), 51.0, -0.2, 0.16, amb);\n  block(c, p, 0.8 * a, 0.012 * K, 22.0, vec3(0.62, 0.64, 0.66), 52.0, -0.25, 0.18, amb);\n  block(c, p, 0.827 * a, 0.03 * K, 7.0, vec3(0.7, 0.66, 0.6), 53.0, -0.15, 0.2, amb);\n  block(c, p, 0.86 * a, 0.024 * K, 9.0, vec3(0.55, 0.52, 0.5), 54.0, -0.2, 0.22, amb);\n  block(c, p, 0.887 * a, 0.02 * K, 6.0, vec3(0.68, 0.64, 0.58), 55.0, -0.2, 0.24, amb);\n  // quay wall and a row of lamps along it\n  float px = 1.0 / uRes.y;\n  if(p.x > 0.455 * a && p.x < 0.9 * a){\n    float q = aa(BASE() - p.y) * aa(p.y - (BASE() - 0.0012));\n    c = mix(c, shade(vec3(0.45, 0.44, 0.42), vec3(0.0, 0.0, -1.0), amb) * 0.8, q);\n    float lx = (floor(p.x / (0.009 * K)) + 0.5) * 0.009 * K;\n    float lamp = exp(-length(p - vec2(lx, BASE() + 0.0018)) * uRes.y / 1.1);\n    c += vec3(1.0, 0.75, 0.45) * lamp * lightsOn() * 0.7;\n  }\n  return c;\n}\n\n// ---------------- things moving on the bay and in the sky ----------------\nvec3 ferry(vec2 p, vec3 c, vec3 amb){\n  float a = asp();\n  float t = fract(uClock / 2700.0);                            // a crossing towards Mols every 45 minutes\n  float vis = smoothstep(0.0, 0.03, t) * smoothstep(0.75, 0.7, t);\n  if(vis <= 0.0) return c;\n  float x = mix(0.44, 0.03, t / 0.75) * a, y = HZ - 0.0006;\n  vec2 l = p - vec2(x, y);\n  if(abs(l.x) > 0.07 || abs(l.y) > 0.006) return c;\n  float L = 0.02;\n  float hull = aa(min(min(0.5 * L - abs(l.x) - max(-l.x - 0.3 * L, 0.0) * 0.0, l.y), 0.0009 - l.y));\n  float sup = aa(min(min(0.32 * L - abs(l.x - 0.002), l.y - 0.0008), 0.0026 - l.y - max(-(l.x - 0.002) - 0.18 * L, 0.0) * 0.4));\n  vec3 white = shade(vec3(0.88), vec3(0.0, 0.0, -1.0), amb);\n  vec3 col = mix(c, shade(vec3(0.15, 0.17, 0.2), vec3(0.0, 0.0, -1.0), amb), hull * vis);\n  float win = step(0.0014, l.y) * step(l.y, 0.0019) * step(abs(l.x - 0.001), 0.005);\n  col = mix(col, mix(white, white * 0.35, win), sup * vis);\n  // wake trailing behind (to the right) and lights at night\n  float wake = exp(-abs(l.y + 0.0004) * uRes.y / 1.2) * smoothstep(0.0, 0.01, l.x - 0.5 * L) * exp(-(l.x - 0.5 * L) / 0.03) * step(l.y, 0.0002);\n  col += amb * wake * 0.5 * vis;\n  vec2 g = vec2(l.x / 0.0016, (l.y - 0.0017) / 0.0006);\n  float lights = step(abs(l.x - 0.001), 0.006) * smoothstep(0.5, 0.15, length(vec2(fract(g.x) - 0.5, g.y)));\n  col += vec3(1.0, 0.85, 0.6) * lights * lightsOn() * 0.6 * vis;\n  return col;\n}\nvec3 sailboats(vec2 p, vec3 c, vec3 amb){\n  float a = asp(), day = 1.0 - dark();\n  if(day <= 0.0 || p.y > HZ + 0.012 || p.y < HZ - 0.003) return c;\n  for(int i = 0; i < 2; i++){\n    float fi = float(i);\n    float x = (0.12 + 0.13 * fi + 0.05 * sin(uClock / 1500.0 + fi * 2.3)) * a, y = HZ - 0.0008 - 0.0004 * fi;\n    vec2 l = p - vec2(x, y);\n    float s = 1.0 - 0.25 * fi;\n    float sail = aa(min(min(l.y, 0.0085 * s - l.y), (l.y / (0.0085 * s)) * -0.0028 * s + 0.0028 * s - abs(l.x + 0.0009 * s)));\n    float hull = aa(min(min(0.0028 * s - abs(l.x), l.y + 0.0006 * s), -l.y + 0.0001));\n    c = mix(c, shade(vec3(0.9), normalize(vec3(-0.5, 0.0, -1.0)), amb), sail * day);\n    c = mix(c, shade(vec3(0.2), vec3(0.0, 0.0, -1.0), amb), hull * day);\n  }\n  return c;\n}\nvec3 gulls(vec2 p, vec3 c){\n  float a = asp(), day = 1.0 - dark();\n  if(day <= 0.0 || p.y < HZ + 0.02 || p.y > HZ + 0.25) return c;\n  float px = 1.0 / uRes.y, cov = 0.0;\n  for(int i = 0; i < 3; i++){\n    float fi = float(i);\n    float t = fract(uT / (70.0 + 25.0 * fi) + fi * 0.37);\n    vec2 b = vec2((-0.1 + 1.2 * t) * a, HZ + 0.07 + 0.05 * fi + 0.02 * sin(uT * 0.3 + fi * 2.0));\n    if(fi == 1.0) b.x = a - b.x;                                     // one flies the other way\n    float s = 0.011 - 0.002 * fi;\n    float flap = sin(uT * (6.0 + fi) + fi * 3.0);\n    vec2 tipL = b + vec2(-s, s * (0.25 + 0.35 * flap)), tipR = b + vec2(s, s * (0.25 + 0.35 * flap));\n    vec2 elL = b + vec2(-0.45 * s, s * (0.35 + 0.1 * flap)), elR = b + vec2(0.45 * s, s * (0.35 + 0.1 * flap));\n    float d = min(min(seg(p, b, elL), seg(p, elL, tipL)), min(seg(p, b, elR), seg(p, elR, tipR)));\n    cov = max(cov, smoothstep(px * 1.2, px * 0.2, d));\n  }\n  return mix(c, skyAt(vec2(p.x, 0.9)) * 0.35, cov * day);\n}\n\nvec3 backdrop(vec2 p, vec3 c){\n  if(p.y > HZ + 0.26 || p.y < HZ - 0.012) return c;\n  vec3 amb = skyAmb(p.x);\n  if(p.y < HZ + 0.15){\n    c = farShores(p, c);\n    c = oldCity(p, c, amb);\n    c = cranes(p, c, amb);\n    c = harbourFront(p, c, amb);\n    c = ferry(p, c, amb);\n    c = sailboats(p, c, amb);\n  }\n  return gulls(p, c);\n}\n\n// ---------------- foreground: the pier, a moored rowing boat, piles, and life on the water ----------------\n// World coordinates for everything near: metres, x to the right, y up from the eye, z straight ahead (south).\nfloat pole(vec2 p, vec3 base, float h, float rad, out float s){\n  vec2 b = toScreen(base), t = toScreen(base + vec3(0.0, h, 0.0));\n  s = (p.y - b.y) / (t.y - b.y);\n  if(s < 0.0 || s > 1.0) return 0.0;\n  float w = rad / length(base.xz) * upr();\n  return aa(w - abs(p.x - b.x));\n}\nconst vec3 LAMP = vec3(-2.3, 0.0, 5.6);   // x, (deck), z of the lamp post\nvec3 lampPos(){ return vec3(LAMP.x, -EYE + 3.75, LAMP.z); }\nfloat daylight(){ return smoothstep(-0.02, 0.06, uSunDir.y); }\nvec3 viewRay(vec2 p){ return dirOf(azel(p)); }\n// where the view ray meets the water (y = -WATERY); w = 0 when it doesn't\nvec3 onWater(vec2 p){ vec3 d = viewRay(p); return d.y < -0.002 ? d * (-WATERY / d.y) : vec3(0.0, 0.0, 1e5); }\n// a clock that repeats every 'period' seconds, offset per item\nfloat cycle(float period, float offset){ return fract(uClock / period + offset); }\n\n// soft shadow on the ground from a vertical post at base b (x,z) with height h and radius r\nfloat postShadow(vec2 g, vec2 b, float h, float r){\n  if(uSunDir.y < 0.01) return 0.0;\n  vec2 s = -normalize(uSunDir.xz + 1e-5);\n  float len = min(h * length(uSunDir.xz) / uSunDir.y, 40.0);\n  vec2 pa = g - b, ba = s * len;\n  float t = clamp(dot(pa, ba) / dot(ba, ba), 0.0, 1.0);\n  float d = length(pa - ba * t);\n  return (1.0 - smoothstep(r * 0.6, r * 1.6 + 0.02 * t * len, d)) * (1.0 - 0.5 * t);\n}\n\n// ---- the pier deck: weathered planks across the pier, staggered joints, nails at the joists\nvec3 pierDeck(vec2 p, vec3 c, vec3 amb, vec3 sunL){\n  vec3 d = viewRay(p);\n  if(d.y > -0.01) return c;\n  float t = -EYE / d.y;\n  vec3 w = d * t;\n  float mPx = t / (upr() * uRes.y);                    // metres per pixel across the view\n  float mPz = mPx / max(-d.y, 0.02);                   // and along the deck\n  const float RX = 0.9, FZ = 7.0, LX = -4.2, PW = 0.145;\n  float cov = aa((RX - w.x) / mPx / uRes.y) * aa((w.x - LX) / mPx / uRes.y) * aa((FZ - w.z) / mPz / uRes.y);\n  if(cov <= 0.0) return c;\n  float k = w.z / PW, row = floor(k);\n  // planks are 2.4 m long, their butt joints staggered from row to row\n  float jx = (w.x + hash1(row * 7.7) * 2.4) / 2.4, piece = floor(jx);\n  float id = hash2(vec2(row, piece));\n  vec3 wood = mix(vec3(0.36, 0.33, 0.29), vec3(0.52, 0.47, 0.4), id);\n  wood = mix(wood, vec3(0.47, 0.46, 0.44), 0.35 * hash2(vec2(piece, row * 3.0)));            // silvered by the weather\n  float grain = noise2(vec2(w.x * 1.6 + id * 50.0, row * 2.0 + fract(k) * 3.0)) * 0.6 + noise2(vec2(w.x * 9.0, row * 7.0 + fract(k) * 9.0)) * 0.4;\n  wood *= 0.8 + 0.32 * grain;\n  // knots\n  vec2 kc = vec2(fract(jx) * 2.4, fract(k) * PW);\n  vec2 kp = vec2(0.4 + 1.6 * hash2(vec2(row, piece + 3.0)), PW * (0.3 + 0.4 * hash2(vec2(row + 5.0, piece))));\n  float knot = smoothstep(0.022, 0.008, length((kc - kp) * vec2(0.6, 1.0))) * step(0.55, hash2(vec2(piece, row + 9.0)));\n  wood *= 1.0 - 0.45 * knot;\n  // gaps between rows and at butt joints, and pairs of nails over each joist (every 0.6 m)\n  float gd = min(fract(k), 1.0 - fract(k)) * PW;\n  float fadeZ = 1.0 - smoothstep(0.03, 0.1, mPz);\n  float gap = (1.0 - smoothstep(0.004, 0.004 + mPz, gd)) * fadeZ;\n  float jd = min(fract(jx), 1.0 - fract(jx)) * 2.4;\n  gap = max(gap, (1.0 - smoothstep(0.003, 0.003 + mPx, jd)) * (1.0 - smoothstep(0.02, 0.06, mPx)));\n  float nx = abs(fract(w.x / 0.6) - 0.5) * 0.6;\n  float nail = smoothstep(0.012, 0.004, length(vec2(nx, abs(fract(k) - 0.5) * PW - 0.04))) * fadeZ;\n  wood = mix(wood, vec3(0.16, 0.15, 0.14), nail * 0.8);\n  wood *= 1.0 - 0.75 * gap;\n  float edge = max(max(smoothstep(RX - 0.2, RX - 0.16, w.x), smoothstep(LX + 0.2, LX + 0.16, w.x)), smoothstep(FZ - 0.2, FZ - 0.16, w.z));\n  wood = mix(wood, vec3(0.27, 0.24, 0.21), edge * 0.6);\n  float damp = smoothstep(0.55, 0.85, noise2(w.xz * 0.6)) * 0.35;                          // patches still damp from the sea air\n  wood *= 1.0 - damp * 0.5;\n  // sunlight, with shadows of the posts on the deck\n  vec2 g = w.xz;\n  float sh = max(max(postShadow(g, LAMP.xz, 3.6, 0.07), postShadow(g, vec2(0.72, 3.7), 1.45, 0.06)),\n                 max(postShadow(g, vec2(-1.3, 6.75), 0.55, 0.16), postShadow(g, vec2(0.35, 6.75), 0.55, 0.16)));\n  sh = max(sh, postShadow(g, vec2(0.72, 3.64), 1.2, 0.36) * 0.9);                       // the life ring\n  vec3 sun = sunL * (max(uSunDir.y, 0.0) * 0.9 + 0.22 * smoothstep(0.0, 0.06, uSunDir.y)) * (1.0 - sh);   // low sun still rakes the rough planks\n  vec3 col = wood * (amb * mix(0.8, 0.3, dark()) + sun + uMoonLight * uExpo * max(uMoonDir.y, 0.0) * 0.8);\n  // a soft sheen of sky on damp wood at grazing angles, and a hint of sun glare\n  float graze = 1.0 - smoothstep(0.05, 0.4, -d.y);\n  col += skyAt(vec2(p.x, HZ + (HZ - p.y) * 0.4)) * (0.04 + 0.08 * damp) * graze;\n  vec3 R = reflect(d, vec3(0.0, 1.0, 0.0));\n  col += uSunDisk * uExpo * pow(max(dot(R, uSunDir), 0.0), 40.0) * 0.004 * (0.3 + damp) * (1.0 - sh);\n  vec3 L = lampPos() - w;\n  col += vec3(1.0, 0.7, 0.4) * lightsOn() * 3.0 / (1.0 + dot(L, L) * 0.3) * wood;\n  col *= 0.75 + 0.25 * smoothstep(0.0, 0.08, p.y);\n  return mix(c, col, cov);\n}\n\n// ---- a white rowing boat (a \"jolle\") moored alongside, rocking on the swell\nconst vec3 BOAT = vec3(1.95, 0.0, 4.3);\nconst float BL = 4.0, BB = 1.45, BF = 0.5;     // length, beam, freeboard (m)\nvec3 boatMotion(){ return vec3(0.045 * sin(uT * 0.9) * (0.5 + uWind), 0.015 * sin(uT * 0.7 + 1.0), 0.04 * sin(uT * 0.8 + 2.0) * (0.5 + uWind)); }   // roll, pitch, heave\nfloat boatHalfWidth(float z){            // planform: pointed bow ahead, broad transom aft\n  float s = (z - BOAT.z) / (0.5 * BL);\n  if(abs(s) > 1.0) return -1.0;\n  return 0.5 * BB * (1.0 - pow(max(s, 0.0), 2.2)) * (1.0 - 0.3 * pow(max(-s, 0.0), 3.0));\n}\n// ray hit on the boat's tilted horizontal plane at height y0 above the water\nvec3 boatPlane(vec3 d, float y0){\n  vec3 m = boatMotion();\n  float h = -WATERY + m.z + y0 - m.x * BOAT.x - m.y * BOAT.z;\n  float den = d.y - m.x * d.x - m.y * d.z;\n  if(den > -1e-4) return vec3(0.0, 0.0, 1e5);\n  return d * (h / den);\n}\nvec3 boat(vec2 p, vec3 c, vec3 amb, vec3 sunL){\n  if(p.x < 0.53 * asp() || p.y > HZ - 0.08) return c;\n  vec3 d = viewRay(p);\n  vec3 G = boatPlane(d, BF);                         // the gunwale (top edge)\n  float hw = boatHalfWidth(G.z);\n  float inG = hw > 0.0 ? (hw - abs(G.x - BOAT.x)) : -1.0;\n  vec3 m = boatMotion();\n  vec3 sunN; vec3 col; float cov = 0.0;\n  if(inG > 0.0){\n    // looking down into the boat: varnished floorboards, two thwarts, the rim of the gunwale\n    float s = (G.z - BOAT.z) / (0.5 * BL);\n    float rim = smoothstep(0.075, 0.055, inG);\n    float thwart = max(smoothstep(0.13, 0.11, abs(s - 0.15)), smoothstep(0.13, 0.11, abs(s + 0.45)));\n    float boards = 0.85 + 0.15 * step(0.5, fract((G.x - BOAT.x) / 0.12));\n    vec3 alb = mix(vec3(0.42, 0.28, 0.16) * boards, vec3(0.55, 0.38, 0.22), thwart);\n    alb = mix(alb, vec3(0.82, 0.82, 0.8), rim);\n    float inside = 1.0 - rim - thwart;\n    float aoIn = 0.55 + 0.45 * smoothstep(0.0, 0.35, inG);\n    sunN = normalize(vec3(-m.x, 1.0, -m.y));\n    col = alb * (amb * mix(0.75, 0.3, dark()) * mix(1.0, aoIn, inside) + sunL * max(dot(sunN, uSunDir), 0.0) * 0.85 * mix(1.0, aoIn, inside));\n    cov = aa(inG * upr() / length(G.xz) / 1.0);\n  } else {\n    // the hull side facing us, from the waterline up to the gunwale\n    vec3 W = boatPlane(d, 0.0);\n    float hwW = boatHalfWidth(W.z) * 0.9;\n    float inW = hwW > 0.0 ? (hwW - abs(W.x - BOAT.x)) : -1.0;\n    if(inW <= 0.0 && inG < -0.03) return c;\n    float side = BOAT.x - max(hwW, 0.0);\n    float t = d.x != 0.0 ? side / d.x : 0.0;\n    float v = clamp((d.y * t + WATERY - m.z) / BF, 0.0, 1.0);\n    vec3 alb = vec3(0.86, 0.87, 0.85);\n    alb = mix(alb, vec3(0.08, 0.17, 0.36), smoothstep(0.78, 0.8, v) * (1.0 - smoothstep(0.9, 0.92, v)));   // blue stripe\n    alb = mix(alb, vec3(0.32, 0.12, 0.1), smoothstep(0.1, 0.05, v));                                       // antifouling at the waterline\n    sunN = normalize(vec3(-1.0, 0.25 - v * 0.2, -0.3));\n    col = alb * (amb * mix(0.7, 0.3, dark()) + sunL * max(dot(sunN, uSunDir), 0.0) * 0.9 + uMoonLight * uExpo * max(dot(sunN, uMoonDir), 0.0));\n    col *= 0.75 + 0.25 * v;\n    cov = max(aa(inW * upr() / length(W.xz)), aa((inG + 0.03) * upr() / length(G.xz)) * step(0.0, inW + 0.05));\n    cov *= step(-0.05, inW);\n  }\n  vec3 Lp = lampPos() - vec3(BOAT.x, -WATERY + 0.4, BOAT.z);\n  col += vec3(1.0, 0.7, 0.4) * lightsOn() * 0.6 / (1.0 + dot(Lp, Lp) * 0.3);\n  return mix(c, col, clamp(cov, 0.0, 1.0));\n}\n// the boat's shadow and wavelets on the water around it\nvec3 boatWater(vec2 p, vec3 c, vec3 amb){\n  if(p.x < 0.53 * asp() || p.y > HZ - 0.06) return c;\n  vec3 W = onWater(p);\n  float hw = boatHalfWidth(W.z);\n  float out_ = hw > 0.0 ? abs(W.x - BOAT.x) - hw : 1.0 + abs(W.z - BOAT.z) - 0.5 * BL;\n  if(out_ > 0.8) return c;\n  c *= 1.0 - 0.45 * smoothstep(0.6, 0.0, out_);\n  float rip = sin(out_ * 22.0 - uT * 2.6) * 0.5 + 0.5;\n  return c + amb * 0.12 * rip * smoothstep(0.5, 0.05, out_) * (0.4 + uWind);\n}\n// a mooring line from the bollard at the end of the pier to the boat's bow\nvec3 rope(vec2 p, vec3 c, vec3 amb){\n  if(p.x < 0.5 * asp() || p.y > HZ - 0.05) return c;\n  vec3 m = boatMotion();\n  vec3 a = vec3(0.35, -EYE + 0.45, 6.75);\n  vec3 b = vec3(BOAT.x - 0.05, -WATERY + BF + m.z + 0.05, BOAT.z + 0.45 * BL);\n  float dmin = 1e3;\n  vec2 prev = toScreen(a);\n  for(int i = 1; i <= 8; i++){\n    float t = float(i) / 8.0;\n    vec3 q = mix(a, b, t); q.y -= 0.35 * 4.0 * t * (1.0 - t);       // sagging\n    vec2 s = toScreen(q);\n    dmin = min(dmin, seg(p, prev, s));\n    prev = s;\n  }\n  float w = 0.018 * upr() / 6.0;\n  float cov = aa(w - dmin);\n  return mix(c, shade(vec3(0.72, 0.66, 0.52), vec3(0.0, 1.0, -0.3), amb), cov);\n}\n\n// ---- old wooden mooring piles further out to the right, a gull resting on one of them\nvec3 pileAt(float i){ return i < 0.5 ? vec3(3.7, -WATERY, 7.2) : (i < 1.5 ? vec3(5.0, -WATERY, 10.2) : (i < 2.5 ? vec3(6.7, -WATERY, 14.0) : vec3(9.0, -WATERY, 19.5))); }\nvec3 piles(vec2 p, vec3 c, vec3 amb, vec3 sunL){\n  if(p.x < 0.55 * asp() || p.y > HZ) return c;\n  for(int i = 0; i < 4; i++){\n    float fi = float(i);\n    vec3 b = pileAt(fi);\n    float h = 2.0 + 0.4 * hash1(fi * 3.3);\n    vec2 bs = toScreen(b), t = toScreen(b + vec3(0.0, h, 0.0));\n    float k = upr() / length(b.xz);\n    float wdt = 0.14 * k;\n    float rel = (p.x - bs.x) / wdt;\n    float top = t.y - 0.05 * k * rel * rel;\n    float bob = 0.0015 * sin(uT * 1.2 + fi * 1.7) * (0.5 + uWind);\n    float cov = aa(min(wdt - abs(p.x - bs.x), top - p.y)) * aa(p.y - bs.y - bob);\n    vec2 dd = (p - bs) / vec2(0.32 * k, 0.045 * k);\n    float fn = noise2(vec2(p.x / k * 5.0, uT * 0.8 + fi));\n    c += amb * 0.45 * exp(-dot(dd, dd) * 0.8) * smoothstep(0.35, 0.8, fn) * (0.4 + uWind) * step(p.y, bs.y + 0.002);\n    if(cov <= 0.0) continue;\n    vec3 N = normalize(vec3(rel, 0.0, -sqrt(max(1.0 - rel * rel, 0.0))));\n    float grain = noise2(vec2(rel * 3.0 + fi * 9.0, (p.y - bs.y) / k * 1.2));\n    vec3 alb = mix(vec3(0.24, 0.2, 0.17), vec3(0.4, 0.35, 0.29), grain);\n    alb = mix(alb, vec3(0.09, 0.12, 0.08), smoothstep(0.4 * k, 0.0, p.y - bs.y) * 0.8);\n    alb = mix(alb, vec3(0.75, 0.74, 0.7), smoothstep(0.5, 0.8, noise2(vec2(rel * 5.0, fi))) * smoothstep(0.15 * k, 0.0, top - p.y) * 0.5);  // bird-whitened top\n    vec3 col = alb * (amb * 0.7 + sunL * max(dot(N, uSunDir), 0.0) * 0.9 + uMoonLight * uExpo * max(dot(N, uMoonDir), 0.0));\n    c = mix(c, col, cov);\n  }\n  return c;\n}\nvec3 perchedGull(vec2 p, vec3 c, vec3 amb, vec3 sunL){\n  // sits on the nearest pile for a while, then is off again\n  float here = step(cycle(780.0, 0.1), 0.62) * daylight();\n  if(here <= 0.0) return c;\n  vec3 b = pileAt(0.0);\n  float h = 2.0 + 0.4 * hash1(0.0);\n  vec2 t = toScreen(b + vec3(0.0, h, 0.0));\n  float k = upr() / length(b.xz);\n  vec2 q = (p - t) / k;                       // metres around the top of the pile\n  if(abs(q.x) > 0.5 || q.y < -0.1 || q.y > 0.5) return c;\n  float look = step(0.5, fract(uClock / 23.0)) * 2.0 - 1.0;           // turns its head now and then\n  float body = length((q - vec2(-0.02 * look, 0.14)) / vec2(0.2, 0.09)) - 1.0;\n  float head = length(q - vec2(0.15 * look, 0.27)) / 0.06 - 1.0;\n  float neck = seg(q, vec2(0.07 * look, 0.17), vec2(0.14 * look, 0.25)) / 0.045 - 1.0;\n  float tail = seg(q, vec2(-0.1 * look, 0.14), vec2(-0.26 * look, 0.17)) / 0.035 - 1.0;\n  float beak = seg(q, vec2(0.2 * look, 0.27), vec2(0.27 * look, 0.26)) / 0.012 - 1.0;\n  float legs = min(seg(q, vec2(-0.02, 0.07), vec2(-0.03, 0.0)), seg(q, vec2(0.03, 0.07), vec2(0.03, 0.0))) / 0.01 - 1.0;\n  float wing = length((q - vec2(-0.05 * look, 0.165)) / vec2(0.17, 0.055)) - 1.0;\n  float shapeD = min(min(min(body, head), min(neck, tail)), legs);\n  float px = 1.0 / (uRes.y * k);\n  vec3 white = vec3(0.92, 0.92, 0.9), grey = vec3(0.55, 0.58, 0.62);\n  vec3 alb = mix(white, grey, step(wing, 0.0));\n  alb = mix(alb, vec3(0.1), step(tail, 0.0) * step(0.0, wing) * 0.6);\n  vec3 col = shade(alb, normalize(vec3(0.0, 0.6, -1.0)), amb);\n  c = mix(c, col, clamp(-shapeD * 0.12 / px + 0.5, 0.0, 1.0));\n  c = mix(c, shade(vec3(0.95, 0.75, 0.15), vec3(0.0, 0.0, -1.0), amb), clamp(-beak * 0.012 / px + 0.5, 0.0, 1.0));\n  return mix(c, shade(vec3(0.85, 0.6, 0.45), vec3(0.0, 0.0, -1.0), amb), clamp(-legs * 0.01 / px + 0.5, 0.0, 1.0) * step(q.y, 0.075));\n}\n\n// ---- small craft and wildlife: drawn as little figures at their distance, with ripples on the water\n// x position along a crossing that takes 'dur' seconds out of every 'period'; returns 2.0 when off-stage\nfloat crossing(float period, float offset, float dur, float x0, float x1, out float dir){\n  float t = cycle(period, offset) * period;\n  dir = sign(x1 - x0);\n  return t < dur ? mix(x0, x1, t / dur) : 1e4;\n}\nfloat ellipseD(vec2 q, vec2 r){ return (length(q / r) - 1.0) * min(r.x, r.y); }\n// V-shaped wake behind something at (x, z) heading along +dir in x; adds foam to the water point W\nfloat wake(vec3 W, vec2 at, float dir, float strength, float len){\n  vec2 r = vec2((W.x - at.x) * -dir, W.z - at.y);               // r.x: distance behind it\n  if(r.x < -0.5 || r.x > len) return 0.0;\n  float arm = abs(abs(r.y) - max(r.x, 0.0) * 0.36);              // the Kelvin wedge, ~19.5°\n  float lines = exp(-arm / (0.08 + 0.02 * r.x)) * (1.0 - r.x / len);\n  float trail = exp(-abs(r.y) / (0.25 + 0.03 * r.x)) * exp(-r.x / (0.25 * len));\n  float n = noise2(vec2(W.x * 3.0, W.z * 3.0 + uT * 0.5));\n  return (lines * 0.8 + trail * 0.6) * (0.6 + 0.6 * n) * strength;\n}\nvec3 kayak(vec2 p, vec3 c, vec3 amb, vec3 sunL, vec3 W){\n  float day = daylight();\n  if(day <= 0.0) return c;\n  float dir; float x = crossing(420.0, 0.2, 170.0, -24.0, 22.0, dir);\n  if(x > 1e3) return c;\n  const float Z = 16.0;\n  float bob = 0.04 * sin(uT * 1.6);\n  vec3 at = vec3(x, -WATERY + bob, Z);\n  // wake on the water behind it\n  if(p.y < HZ) c += amb * 0.35 * wake(W, vec2(x, Z), dir, 0.6, 14.0) * day;\n  vec2 b = toScreen(at);\n  float k = upr() / length(at.xz);\n  vec2 q = (p - b) / k;                       // metres\n  q.x *= dir;\n  if(abs(q.x) > 3.0 || q.y < -0.2 || q.y > 1.6) return c;\n  float px = 1.0 / (uRes.y * k);\n  float hull = ellipseD(q - vec2(0.0, 0.05), vec2(2.4, 0.13));\n  hull = max(hull, -q.y - 0.02);\n  float torso = ellipseD(q - vec2(-0.1, 0.42), vec2(0.17, 0.3));\n  float headD = length(q - vec2(-0.08, 0.84)) - 0.11;\n  float stroke = uT * 2.4;\n  vec2 hand = vec2(-0.05, 0.55);\n  vec2 tipA = hand + vec2(0.25 * cos(stroke), 0.9 * sin(stroke)) * 1.1, tipB = hand - vec2(0.25 * cos(stroke), 0.9 * sin(stroke)) * 1.1;\n  float paddle = seg(q, tipA, tipB) - 0.02;\n  float blade = min(length((q - tipA) / vec2(0.06, 0.16)) - 1.0, length((q - tipB) / vec2(0.06, 0.16)) - 1.0) * 0.06;\n  vec3 col = c;\n  col = mix(col, shade(vec3(0.95, 0.75, 0.1), vec3(0.0, 0.4, -1.0), amb), clamp(-hull / px + 0.5, 0.0, 1.0));\n  col = mix(col, shade(vec3(0.85, 0.25, 0.1), vec3(0.0, 0.0, -1.0), amb), clamp(-torso / px + 0.5, 0.0, 1.0));\n  col = mix(col, shade(vec3(0.55, 0.42, 0.33), vec3(0.0, 0.0, -1.0), amb), clamp(-headD / px + 0.5, 0.0, 1.0));\n  col = mix(col, shade(vec3(0.15), vec3(0.0, 0.0, -1.0), amb), clamp(-min(paddle, blade) / px + 0.5, 0.0, 1.0));\n  return mix(c, col, day);\n}\nvec3 paddleboard(vec2 p, vec3 c, vec3 amb, vec3 sunL, vec3 W){\n  float day = daylight();\n  if(day <= 0.0) return c;\n  float dir; float x = crossing(600.0, 0.55, 300.0, 16.0, -5.0, dir);\n  if(x > 1e3) return c;\n  const float Z = 12.5;\n  vec3 at = vec3(x, -WATERY + 0.03 * sin(uT * 1.3), Z);\n  if(p.y < HZ) c += amb * 0.25 * wake(W, vec2(x, Z), dir, 0.4, 6.0) * day;\n  vec2 b = toScreen(at);\n  float k = upr() / length(at.xz);\n  vec2 q = (p - b) / k; q.x *= dir;\n  if(abs(q.x) > 2.0 || q.y < -0.2 || q.y > 2.2) return c;\n  float px = 1.0 / (uRes.y * k);\n  float sway = 0.04 * sin(uT * 1.3);\n  float board = max(ellipseD(q - vec2(0.0, 0.03), vec2(1.55, 0.06)), -q.y - 0.01);\n  float legs = min(seg(q, vec2(-0.08, 0.06), vec2(-0.06 + sway, 0.85)), seg(q, vec2(0.12, 0.06), vec2(0.04 + sway, 0.85))) - 0.07;\n  float body = ellipseD(q - vec2(0.0 + sway * 1.5, 1.2), vec2(0.18, 0.36));\n  float headD = length(q - vec2(0.03 + sway * 2.0, 1.66)) - 0.11;\n  float ph = uT * 0.9;\n  vec2 top = vec2(0.25 + 0.15 * sin(ph), 1.75), bot = vec2(0.5 + 0.45 * sin(ph), -0.05 + 0.15 * max(cos(ph), 0.0));\n  float paddle = seg(q, top, bot) - 0.02;\n  vec3 col = c;\n  col = mix(col, shade(vec3(0.9, 0.92, 0.95), vec3(0.0, 0.6, -1.0), amb), clamp(-board / px + 0.5, 0.0, 1.0));\n  col = mix(col, shade(vec3(0.12, 0.14, 0.18), vec3(0.0, 0.0, -1.0), amb), clamp(-min(legs, body) / px + 0.5, 0.0, 1.0));\n  col = mix(col, shade(vec3(0.6, 0.45, 0.35), vec3(0.0, 0.0, -1.0), amb), clamp(-headD / px + 0.5, 0.0, 1.0));\n  col = mix(col, shade(vec3(0.2), vec3(0.0, 0.0, -1.0), amb), clamp(-paddle / px + 0.5, 0.0, 1.0));\n  return mix(c, col, day);\n}\nvec3 motorboat(vec2 p, vec3 c, vec3 amb, vec3 sunL, vec3 W){\n  // a small motorboat comes in from the right every few minutes, heading out across the bay\n  float dir; float x = crossing(330.0, 0.8, 60.0, 70.0, -60.0, dir);\n  float lit = lightsOn();\n  // its wake keeps rolling in for a while after it has gone by\n  float tSince = cycle(330.0, 0.8) * 330.0;\n  float zPath = 26.0;\n  float wakeFade = 1.0 - smoothstep(60.0, 140.0, tSince);\n  if(p.y < HZ && wakeFade > 0.0){\n    float xs = mix(70.0, -60.0, min(tSince, 60.0) / 60.0);\n    float f = wake(W, vec2(xs, zPath), -1.0, 1.0, 120.0) * wakeFade;\n    // the wake's swell, arriving later at the pier as slow bright ripples\n    float behind = (W.x - xs);\n    float swell = sin((W.z - zPath + abs(behind) * 0.36) * 2.4) * exp(-abs(W.z - zPath - (tSince - 20.0) * 0.25) / 6.0) * step(20.0, tSince) * 0.5;\n    c += amb * (0.5 * f + 0.06 * max(swell, 0.0)) * (1.0 - 0.6 * dark());\n  }\n  if(x > 1e3) return c;\n  vec3 at = vec3(x, -WATERY + 0.05 * sin(uT * 2.0), zPath);\n  vec2 b = toScreen(at);\n  float k = upr() / length(at.xz);\n  vec2 q = (p - b) / k; q.x *= dir;\n  if(abs(q.x) > 4.0 || q.y < -0.3 || q.y > 2.4) return c;\n  float px = 1.0 / (uRes.y * k);\n  float hull = max(min(max(abs(q.x) - 2.8, abs(q.y - 0.35) - 0.35), length((q - vec2(2.8, 0.7)) / vec2(0.9, 0.7)) * 0.6 - 0.6 + 0.0), -q.y);\n  hull = max(hull, q.y - 0.7 - 0.12 * smoothstep(1.5, 3.0, q.x));\n  float cabin = max(abs(q.x + 0.4) - 1.0 - 0.3 * smoothstep(1.3, 0.0, q.y - 0.7) * step(0.0, q.x + 0.4), abs(q.y - 1.05) - 0.35);\n  float glass = max(abs(q.x + 0.1) - 0.55, abs(q.y - 1.12) - 0.16);\n  float spray = exp(-length((q - vec2(2.6, 0.1)) / vec2(0.7, 0.25))) * (0.6 + 0.4 * noise2(q * 6.0 + uT * 4.0));\n  vec3 col = c;\n  col = mix(col, shade(vec3(0.9, 0.9, 0.88), vec3(0.0, 0.2, -1.0), amb), clamp(-hull / px + 0.5, 0.0, 1.0));\n  col = mix(col, shade(vec3(0.82, 0.83, 0.84), vec3(0.0, 0.3, -1.0), amb), clamp(-cabin / px + 0.5, 0.0, 1.0));\n  col = mix(col, skyAt(vec2(p.x, HZ + 0.2)) * 0.5, clamp(-glass / px + 0.5, 0.0, 1.0));\n  col += amb * spray * 0.8 * step(q.y, 0.6);\n  // navigation lights at night: red to port, green to starboard, white on top\n  col += vec3(1.0, 0.9, 0.7) * exp(-length(q - vec2(-0.6, 1.55)) / 0.12) * lit;\n  col += (dir < 0.0 ? vec3(1.0, 0.1, 0.05) : vec3(0.1, 1.0, 0.3)) * exp(-length(q - vec2(1.6, 0.85)) / 0.1) * lit;\n  return col;\n}\nvec3 swimmers(vec2 p, vec3 c, vec3 amb, vec3 W){\n  // morning and afternoon swimmers — Aarhus swims all year, even in winter\n  float h = uHour;\n  float on = smoothstep(6.6, 7.0, h) * (1.0 - smoothstep(9.3, 9.6, h)) + smoothstep(14.8, 15.1, h) * (1.0 - smoothstep(16.8, 17.1, h));\n  if(on <= 0.0 || p.y > HZ - 0.01) return c;\n  for(int i = 0; i < 3; i++){\n    float fi = float(i);\n    float t = uClock / 40.0 + fi * 2.1;\n    vec3 at = vec3(2.8 + 1.6 * fi + 0.9 * sin(t * 0.7), -WATERY, 9.0 + 2.5 * fi + 1.2 * sin(t * 0.5 + fi));\n    float vis = on * step(hash1(floor(uClock / 900.0) + fi * 3.0), 0.75);      // who is in the water varies\n    if(vis <= 0.0) continue;\n    vec2 b = toScreen(at);\n    float k = upr() / length(at.xz);\n    vec2 q = (p - b) / k;\n    if(abs(q.x) > 1.2 || abs(q.y) > 0.5) continue;\n    float px = 1.0 / (uRes.y * k);\n    float bob = 0.03 * sin(uT * 2.0 + fi * 2.0);\n    float headD = length((q - vec2(0.0, 0.1 + bob)) / vec2(1.0, 1.1)) - 0.12;\n    float under = step(q.y, 0.0);\n    vec3 cap = fi < 0.5 ? vec3(0.95, 0.45, 0.1) : (fi < 1.5 ? vec3(0.9, 0.9, 0.85) : vec3(0.85, 0.15, 0.2));\n    vec3 alb = mix(vec3(0.75, 0.55, 0.45), cap, step(0.12 + bob, q.y));\n    c = mix(c, shade(alb, vec3(0.0, 0.3, -1.0), amb), clamp(-headD / px + 0.5, 0.0, 1.0) * (1.0 - under) * vis);\n    // rings of ripples around each head\n    float r = length(q / vec2(1.0, 0.18));\n    c += amb * 0.25 * vis * max(sin(r * 14.0 - uT * 3.0), 0.0) * exp(-r * 2.2) * under;\n  }\n  return c;\n}\nvec3 waterfowl(vec2 p, vec3 c, vec3 amb, vec3 W){\n  // eider ducks drift past in a little group; now and then a pair of mute swans\n  float day = daylight();\n  if(day <= 0.0 || p.y > HZ - 0.005) return c;\n  float dir; float gx = crossing(520.0, 0.35, 360.0, 12.0, -1.0, dir);\n  if(gx < 1e3){\n    for(int i = 0; i < 4; i++){\n      float fi = float(i);\n      vec3 at = vec3(gx + 1.0 * fi + 0.3 * sin(uT * 0.3 + fi), -WATERY, 9.5 + 0.8 * fi - 0.18 * fi * fi);\n      vec2 b = toScreen(at);\n      float k = upr() / length(at.xz);\n      vec2 q = (p - b) / k; q.x *= dir;\n      if(abs(q.x) > 0.8 || q.y < -0.2 || q.y > 0.5) continue;\n      float px = 1.0 / (uRes.y * k);\n      float male = step(0.5, hash1(fi * 5.1 + 1.0));\n      float bodyD = max(ellipseD(q - vec2(0.0, 0.06), vec2(0.26, 0.1)), -q.y);\n      float headD = length(q - vec2(0.2, 0.2)) - 0.065;\n      float neckD = seg(q, vec2(0.13, 0.1), vec2(0.19, 0.18)) - 0.045;\n      float d = min(bodyD, min(headD, neckD));\n      vec3 alb = male > 0.5 ? mix(vec3(0.08), vec3(0.92, 0.92, 0.88), step(0.07, q.y)) : vec3(0.42, 0.3, 0.2);\n      alb = mix(alb, male > 0.5 ? vec3(0.08) : vec3(0.35, 0.25, 0.17), step(0.24, q.y) * step(0.17, q.x) * 0.7);\n      c = mix(c, shade(alb, vec3(0.0, 0.5, -1.0), amb), clamp(-d / px + 0.5, 0.0, 1.0) * day);\n      vec2 rq = vec2((q.x + 0.25) * 0.5, q.y * 4.0);\n      c += amb * 0.18 * exp(-abs(abs(rq.y) - max(-rq.x, 0.0) * 0.8) * 8.0) * step(rq.x, 0.0) * step(-1.5, rq.x) * step(q.y, 0.0) * day;\n    }\n  }\n  float sdir; float sx = crossing(1500.0, 0.05, 420.0, -5.0, 14.0, sdir);\n  if(sx < 1e3){\n    for(int i = 0; i < 2; i++){\n      float fi = float(i);\n      vec3 at = vec3(sx - 2.2 * fi, -WATERY, 15.0 + 1.5 * fi);\n      vec2 b = toScreen(at);\n      float k = upr() / length(at.xz);\n      vec2 q = (p - b) / k; q.x *= sdir;\n      if(abs(q.x) > 1.4 || q.y < -0.2 || q.y > 1.2) continue;\n      float px = 1.0 / (uRes.y * k);\n      float bodyD = max(ellipseD(q - vec2(0.0, 0.12), vec2(0.6, 0.22)), -q.y);\n      bodyD = min(bodyD, max(ellipseD(q - vec2(-0.25, 0.3), vec2(0.35, 0.16)), -q.y));     // raised wings\n      // the S-curve of the neck\n      float n1 = seg(q, vec2(0.38, 0.2), vec2(0.5, 0.55)), n2 = seg(q, vec2(0.5, 0.55), vec2(0.44, 0.8));\n      float neckD = min(n1, n2) - 0.05;\n      float headD = length((q - vec2(0.52, 0.84)) / vec2(1.3, 1.0)) - 0.07;\n      float beakD = seg(q, vec2(0.58, 0.83), vec2(0.7, 0.8)) - 0.022;\n      c = mix(c, shade(vec3(0.95, 0.95, 0.93), vec3(0.0, 0.5, -1.0), amb), clamp(-min(bodyD, min(neckD, headD)) / px + 0.5, 0.0, 1.0) * day);\n      c = mix(c, shade(vec3(0.9, 0.4, 0.1), vec3(0.0, 0.0, -1.0), amb), clamp(-beakD / px + 0.5, 0.0, 1.0) * day);\n    }\n  }\n  return c;\n}\nvec3 buoy(vec2 p, vec3 c, vec3 amb){\n  vec3 w = vec3(10.0, 0.0, 38.0);\n  float bob = 0.12 * sin(uT * 1.3) * (0.5 + uWind);\n  vec2 b = toScreen(vec3(w.x, -WATERY + bob, w.z));\n  float k = upr() / length(w.xz);\n  vec2 l = p - b;\n  if(abs(l.x) > 0.02 || l.y < -0.003 || l.y > 0.03) return c;\n  float tilt = 0.06 * sin(uT * 1.1);\n  l.x -= l.y * tilt;\n  float body = aa(min(0.4 * k - abs(l.x), min(l.y, 1.6 * k - l.y)));\n  float top = aa(min(0.18 * k - abs(l.x), min(l.y - 1.6 * k, 2.1 * k - l.y)));\n  c = mix(c, shade(vec3(0.75, 0.08, 0.06), vec3(0.0, 0.0, -1.0), amb), body);\n  c = mix(c, shade(vec3(0.2), vec3(0.0, 0.0, -1.0), amb), top);\n  float flash = step(0.82, fract(uT / 4.0)) * lightsOn();\n  c += vec3(1.0, 0.15, 0.08) * exp(-length(l - vec2(0.0, 2.2 * k)) * uRes.y / 1.5) * flash * 1.5;\n  return c;\n}\nvec3 lampGlow(vec2 p){\n  float dl = length(p - toScreen(lampPos()));\n  return vec3(1.0, 0.72, 0.42) * lightsOn() * (0.25 * exp(-dl / 0.012) + 0.06 * exp(-dl / 0.06));\n}\nvec3 lampOnWater(vec2 p, vec3 c){\n  float lit = lightsOn();\n  if(lit <= 0.0 || p.y > HZ) return c;\n  vec2 lh = toScreen(lampPos());\n  float dz = HZ - p.y;\n  float wob = (noise2(vec2(p.y * 300.0, uT * 1.5)) - 0.5) * 0.006 * (0.5 + uWind);\n  float streak = exp(-abs(p.x - lh.x + wob) / (0.002 + 0.03 * dz)) * smoothstep(0.0, 0.05, dz) * smoothstep(0.32, 0.12, dz);\n  return c + vec3(1.0, 0.7, 0.4) * streak * lit * 0.12 * (0.6 + 0.4 * noise2(vec2(p.x * 200.0, p.y * 900.0 - uT * 2.0)));\n}\n\nvec3 pierThings(vec2 p, vec3 c, vec3 amb, vec3 sunL){\n  vec3 iron = vec3(0.12, 0.13, 0.14);\n  float lit = lightsOn();\n  // bollards at the end of the pier, rounded caps catching the light\n  for(int i = 0; i < 2; i++){\n    vec3 b = vec3(i == 0 ? -1.3 : 0.35, -EYE, 6.75);\n    float s; float cov = pole(p, b, 0.55, 0.14, s);\n    if(cov > 0.0){\n      vec2 bs = toScreen(b);\n      float rel = (p.x - bs.x) / (0.14 * upr() / length(b.xz));\n      vec3 N = normalize(vec3(rel, 0.4 * smoothstep(0.75, 1.0, s), -sqrt(max(1.0 - rel * rel, 0.0))));\n      vec3 col = shade(iron * (1.0 + 0.5 * smoothstep(0.85, 1.0, s)), N, amb);\n      col += uSunCol * uExpo * pow(max(dot(reflect(viewRay(p), N), uSunDir), 0.0), 20.0) * 0.15;\n      vec3 L = lampPos() - b; col += vec3(1.0, 0.7, 0.4) * lit * 0.4 / (1.0 + dot(L, L) * 0.5);\n      c = mix(c, col, cov);\n    }\n  }\n  // life ring on a post near the right edge\n  vec3 rb = vec3(0.72, -EYE, 3.7);\n  float s; float pc = pole(p, rb, 1.45, 0.05, s);\n  if(pc > 0.0){\n    float grain = noise2(vec2(p.x * 3000.0, s * 30.0));\n    c = mix(c, shade(vec3(0.42, 0.37, 0.3) * (0.85 + 0.3 * grain), normalize(vec3(-0.4, 0.0, -1.0)), amb), pc);\n  }\n  vec2 rc = toScreen(rb + vec3(0.0, 0.95, -0.06));\n  float k = upr() / length(rb.xz);\n  float rr = length(p - rc);\n  float ring = aa(0.36 * k - rr) * aa(rr - 0.21 * k);\n  if(ring > 0.0){\n    float ang = atan(p.y - rc.y, p.x - rc.x);\n    float seg4 = step(0.5, fract(ang / (PI * 0.5) + 0.125));\n    vec3 alb = mix(vec3(0.82, 0.12, 0.08), vec3(0.88, 0.88, 0.84), seg4);\n    alb *= 0.9 + 0.15 * noise2(vec2(ang * 40.0, rr / k * 30.0));                      // worn, a bit grubby\n    float z = sqrt(max(1.0 - pow((rr / k - 0.285) / 0.075, 2.0), 0.0));\n    vec3 N = normalize(vec3((p - rc) / max(rr, 1e-5) * (1.0 - z), -z - 0.3));\n    vec3 col = shade(alb, N, amb);\n    col += uSunCol * uExpo * pow(max(dot(reflect(viewRay(p), N), uSunDir), 0.0), 12.0) * 0.08;\n    vec3 L = lampPos() - rb; col += alb * vec3(1.0, 0.7, 0.4) * lit * 0.8 / (1.0 + dot(L, L) * 0.4);\n    c = mix(c, col, ring);\n  }\n  // the lamp post: a tapered mast with a base, a lantern on top\n  vec3 lb = vec3(LAMP.x, -EYE, LAMP.z);\n  float lk = upr() / length(LAMP.xz);\n  float ls; float lc = pole(p, lb, 3.6, 0.075, ls);\n  if(lc > 0.0){\n    vec2 bs = toScreen(lb);\n    float wdt = mix(0.075, 0.045, smoothstep(0.0, 0.3, ls)) + 0.03 * smoothstep(0.06, 0.0, ls);\n    float rel = (p.x - bs.x) / (wdt * lk);\n    lc = aa(wdt * lk - abs(p.x - bs.x));\n    vec3 N = normalize(vec3(rel, 0.0, -sqrt(max(1.0 - rel * rel, 0.0))));\n    vec3 col = shade(vec3(0.16, 0.2, 0.19), N, amb);\n    col += uSunCol * uExpo * pow(max(dot(reflect(viewRay(p), N), uSunDir), 0.0), 30.0) * 0.12;\n    c = mix(c, col, lc);\n  }\n  vec2 lh = toScreen(lampPos());\n  vec2 lq = (p - lh) / lk;\n  float head = aa((min(0.17 - abs(lq.x) + 0.06 * (lq.y + 0.26), 0.26 - abs(lq.y))) * lk);\n  float glass = aa((min(0.12 - abs(lq.x) + 0.05 * (lq.y + 0.2), 0.18 - abs(lq.y + 0.02))) * lk);\n  float cap = aa((min(0.24 - abs(lq.x) - max(lq.y - 0.24, 0.0) * 1.6, min(lq.y - 0.22, 0.4 - lq.y))) * lk);\n  c = mix(c, shade(vec3(0.16, 0.2, 0.19), vec3(0.0, 0.3, -1.0), amb), max(head, cap));\n  c = mix(c, mix(shade(vec3(0.5, 0.52, 0.5), vec3(0.0, 0.0, -1.0), amb), vec3(1.6, 1.1, 0.6), lit), glass);\n  return c + lampGlow(p);\n}\n\nvec3 foreground(vec2 p, vec3 c){\n  if(p.y > HZ + 0.25) return c + lampGlow(p);\n  vec3 amb = skyAmb(p.x), sunL = uSunCol * uExpo;\n  if(p.y < HZ){\n    vec3 W = onWater(p);\n    c = lampOnWater(p, c);\n    c = buoy(p, c, amb);\n    c = motorboat(p, c, amb, sunL, W);\n    c = waterfowl(p, c, amb, W);\n    c = kayak(p, c, amb, sunL, W);\n    c = paddleboard(p, c, amb, sunL, W);\n    c = swimmers(p, c, amb, W);\n    c = piles(p, c, amb, sunL);\n    c = boatWater(p, c, amb);\n    c = boat(p, c, amb, sunL);\n    c = pierDeck(p, c, amb, sunL);\n  }\n  c = perchedGull(p, c, amb, sunL);\n  c = rope(p, c, amb);\n  return pierThings(p, c, amb, sunL);\n}\n"}